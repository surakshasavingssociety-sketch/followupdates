{
  "id": "/",
  "name": "FollowExam — Government Exam & Scholarship Portal",
  "short_name": "FollowExam",
  "description": "Official government job, result, admit card, exam, admission and scholarship notifications, analysed and linked to the original source.",
  "lang": "en-IN",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#f5f8fc",
  "theme_color": "#0b4f9c",
  "categories": ["education", "government", "productivity"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192-maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "All updates",
      "short_name": "Updates",
      "description": "Every analysed government notification",
      "url": "/jobs/",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Scholarships",
      "short_name": "Scholarships",
      "description": "Central and state scholarship schemes",
      "url": "/scholarships/",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Career planner",
      "short_name": "Career",
      "description": "Choose a goal and follow the steps",
      "url": "/career/",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
