rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
     }

     function adminRole() {
       return isAdmin()
         ? get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role
         : null;
     }

     function isSuperAdmin() {
       return isAdmin() && (adminRole() == null || adminRole() == 'super_admin');
     }

     function hasRole(role) {
       return isAdmin() && adminRole() == role;
    }

    function validEmail(value) {
      return value is string && value.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') && value.size() < 200;
    }

    // Published jobs: everyone can read. Only admins can write.
    match /jobs/{jobId} {
      allow read: if resource.data.status == 'published';
      allow read: if isAdmin();
      allow create, update: if isAdmin();
     allow delete: if isSuperAdmin();
    }

    // Review queue: admins only.
    match /pending/{itemId} {
      allow read, write: if isAdmin();
    }

    // Admin allow-list: a user can read only their own doc; admins can list,
    // but only Super Admins can add, change roles or remove admins.
    match /admins/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow read: if isAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    // Newsletter subscribers.
    // Public create/update is allowed so the subscribe form works without login.
    // No public reads, so the list cannot be scraped.
    match /subscribers/{subscriberId} {
      allow create, update: if
        validEmail(request.resource.data.email) &&
        request.resource.data.active is bool;
      allow read, delete: if isAdmin();
    }

    // User profile.
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
      allow read: if isAdmin();

      // Saved jobs subcollection.
      match /saved/{jobId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // Contact/feedback messages (optional collection).
    match /messages/{messageId} {
      allow create: if true;
      allow read, delete: if isAdmin();
    }

    // Institution enquiries. Anyone can submit a validated enquiry; only admins
    // can read or change its status.
    match /inquiries/{inquiryId} {
      allow create: if
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 120 &&
        validEmail(request.resource.data.email) &&
        request.resource.data.message is string &&
        request.resource.data.message.size() >= 10 &&
        request.resource.data.message.size() <= 2000 &&
        request.resource.data.institutionId is string &&
        request.resource.data.status == 'new' &&
        request.resource.data.consent == true;
      allow read, update, delete: if isAdmin();
    }

    // Admin activity audit log.
    match /adminActivity/{entryId} {
      allow read, write: if isAdmin();
    }

    // Social post drafts: admins can manage; only admin-side code writes them.
    match /socialDrafts/{draftId} {
      allow read, write: if isAdmin();
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
