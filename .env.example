# ---------- Public (browser) ----------
# Site URL: local par http://localhost:4321, production par https://<project>.web.app
PUBLIC_SITE_URL=https://followupdates.web.app
PUBLIC_CONTACT_EMAIL=hello@followupdates.web.app
PUBLIC_TELEGRAM_URL=

# Firebase web config (Firebase Console > Project settings > Your apps > Web app)
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# ---------- Server / GitHub Actions only ----------
# Poora service-account JSON ek line me (secrets me paste karein, file me commit na karein)
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=

SITE_URL=https://followupdates.web.app

# Ingestion
MAX_AGE_DAYS=30
# Exam-cycle queries per run (active exams pehle, phir rotation)
EXAM_QUERIES_PER_RUN=8
# State-wise queries per run (36 states rotate hote hain)
STATE_QUERIES_PER_RUN=6

# Email (Gmail app password). Emails always go one-by-one.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=FollowExam <yourgmail@gmail.com>
# Har email ke beech gap (ms) — Gmail limits se bachne ke liye
EMAIL_DELAY_MS=1500
# Ek run me maximum emails (safe value 300-400)
MAX_EMAILS_PER_RUN=350
# Naye subscriber ka pehla digest kitne din peeche tak dekhe (default 7)
NOTIFY_LOOKBACK_DAYS=7

# Telegram bot (BotFather se token, channel/chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_DELAY_MS=700
