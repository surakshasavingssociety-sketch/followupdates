---
import { NAV, SITE } from "../lib/constants";

const path = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true" data-site-mark>FE</span>
      <span>
        <span data-site-name>{SITE.name}</span>
        <small data-site-tagline>Every exam. One account.</small>
      </span>
    </a>

    <nav class="nav" id="primary-nav" aria-label="Primary">
      {NAV.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <button class="btn btn-ghost btn-sm hidden" type="button" id="install-app">Install app</button>
      <a class="btn btn-ghost btn-sm hidden" href="/admin/" id="header-admin">Admin panel</a>
      <a class="btn btn-outline btn-sm hidden" href="/profile/" id="header-profile">
        <span class="avatar avatar-sm" id="header-avatar" aria-hidden="true">FE</span>
        <span id="header-name">My profile</span>
        <span id="header-role" style="display:none;margin-left:6px;padding:2px 8px;border-radius:999px;background:var(--brand-soft);color:var(--brand);font-size:0.68rem;font-weight:800;letter-spacing:0.03em;text-transform:uppercase;"></span>
      </a>
      <a class="btn btn-primary btn-sm" href="/login/" id="header-signin">Sign in</a>
      <button class="btn btn-ghost btn-sm hidden" type="button" id="header-signout">Sign out</button>
      <button class="menu-toggle" type="button" aria-controls="primary-nav" aria-expanded="false">
        <span class="sr-only">Menu</span>
        <span aria-hidden="true">☰</span>
      </button>
    </div>
  </div>
</header>

<script>
  import { signOutUser, watchAuth } from "../lib/auth";
  import { accessChipLabel, resolveAccess } from "../lib/roles";

  /**
   * Instant brand bridge: admin settings writes the brand to localStorage so the
   * static header/footer pick it up on the next page view without a rebuild.
   */
  try {
    const raw = localStorage.getItem("fex-site-brand");
    if (raw) {
      const brand = JSON.parse(raw) as { siteName?: string; tagline?: string; logoUrl?: string };
      const siteName = (brand.siteName || "").trim();
      if (siteName) {
        document.querySelectorAll<HTMLElement>("[data-site-name]").forEach((el) => (el.textContent = siteName));
        document.querySelectorAll<HTMLElement>("[data-site-copyright]").forEach((el) => (el.textContent = siteName));
        document.title = document.title.replaceAll("FollowExam", siteName);
        document.querySelectorAll<HTMLElement>("[data-site-mark]").forEach((el) => {
          if (!brand.logoUrl || brand.logoUrl.endsWith("favicon.svg")) {
            el.textContent = siteName
              .split(/\s+/)
              .filter(Boolean)
              .slice(0, 2)
              .map((part) => part[0]?.toUpperCase() || "")
              .join("");
          }
        });
      }
      if (brand.tagline) {
        document.querySelectorAll<HTMLElement>("[data-site-tagline]").forEach((el) => (el.textContent = brand.tagline || ""));
      }
      if (brand.logoUrl && !brand.logoUrl.endsWith("favicon.svg")) {
        document.querySelectorAll<HTMLElement>("[data-site-mark]").forEach((el) => {
          el.textContent = "";
          el.style.backgroundImage = `url("${brand.logoUrl}")`;
          el.style.backgroundSize = "cover";
          el.style.backgroundPosition = "center";
        });
      }
    }
  } catch {
    /* localStorage unavailable — keep the build-time brand */
  }

  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const nav = document.querySelector<HTMLElement>("#primary-nav");
  toggle?.addEventListener("click", () => {
    const open = nav?.classList.toggle("open");
    toggle.setAttribute("aria-expanded", String(Boolean(open)));
  });

  const profileLink = document.querySelector<HTMLElement>("#header-profile");
  const nameEl = document.querySelector<HTMLElement>("#header-name");
  const avatar = document.querySelector<HTMLElement>("#header-avatar");
  const roleChip = document.querySelector<HTMLElement>("#header-role");
  const adminLink = document.querySelector<HTMLElement>("#header-admin");
  const signIn = document.querySelector<HTMLElement>("#header-signin");
  const signOut = document.querySelector<HTMLElement>("#header-signout");

  function initials(name: string) {
    return (
      name
        .split(/\s+/)
        .filter(Boolean)
        .slice(0, 2)
        .map((part) => part[0]?.toUpperCase() || "")
        .join("") || "FE"
    );
  }

  watchAuth(async (user) => {
    if (user) {
      const label = user.displayName || user.email?.split("@")[0] || "My profile";
      if (nameEl) nameEl.textContent = label;
      if (avatar) avatar.textContent = initials(label);
      profileLink?.classList.remove("hidden");
      signIn?.classList.add("hidden");
      signOut?.classList.remove("hidden");

      // Recognise the signed-in role and surface the matching entry point.
      const access = await resolveAccess(user);
      if (roleChip) {
        const chip = accessChipLabel(access);
        roleChip.textContent = access.label;
        roleChip.style.display = chip ? "" : "none";
        roleChip.title = chip ? `Signed in as ${access.label}` : "";
      }
      adminLink?.classList.toggle("hidden", access.kind !== "admin");
    } else {
      profileLink?.classList.add("hidden");
      signIn?.classList.remove("hidden");
      signOut?.classList.add("hidden");
      adminLink?.classList.add("hidden");
      if (roleChip) roleChip.style.display = "none";
    }
  });

  signOut?.addEventListener("click", async () => {
    await signOutUser();
    window.location.href = "/login/";
  });

  /* PWA install prompt */
  const installButton = document.querySelector<HTMLButtonElement>("#install-app");
  let deferredPrompt: any = null;
  window.addEventListener("beforeinstallprompt", (event) => {
    event.preventDefault();
    deferredPrompt = event;
    installButton?.classList.remove("hidden");
  });
  installButton?.addEventListener("click", async () => {
    if (!deferredPrompt) return;
    deferredPrompt.prompt();
    await deferredPrompt.userChoice;
    deferredPrompt = null;
    installButton.classList.add("hidden");
  });
  window.addEventListener("appinstalled", () => installButton?.classList.add("hidden"));
</script>
