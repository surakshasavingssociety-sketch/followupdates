---
import { SITE } from "../lib/constants";
type Props = { eyebrow?: string; title?: string };
const { eyebrow = "FollowExam", title = SITE.tagline || "Every government exam. One account." } = Astro.props;
---
<section class="page-banner" aria-label="About FollowExam" style="background: linear-gradient(135deg, #0b4f9c 0%, #083a73 100%); color:#fff; padding: 48px 0;">
  <div class="container">
    <div class="eyebrow" style="background:rgba(255,255,255,0.15);border-color:rgba(255,255,255,0.25);color:#fff;">{eyebrow}</div>
    <h1 style="font-size: clamp(1.5rem, 3.5vw, 2.2rem); margin: 6px 0 12px; letter-spacing: -0.03em; color:#fff;">{title}</h1>
    <p class="muted" style="color: rgba(255,255,255,0.85); max-width: 640px; font-size: 1.05rem; line-height: 1.55;">
      Independent, free information portal for Indian government jobs, board exams, entrance tests, results, admit cards, answer keys, exam dates, admissions, institutions and scholarships. Every published update carries a direct link to the official notification or notice.
    </p>
  </div>
</section>
