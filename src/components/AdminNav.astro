---
const path = Astro.url.pathname.replace(/\/+$/, "") + "/";

const links = [
  { href: "/admin/", label: "Queue", icon: "🗂" },
  { href: "/admin/analytics/", label: "Analytics", icon: "📊" },
  { href: "/admin/users/", label: "Users", icon: "👤" },
  { href: "/admin/inquiries/", label: "Enquiries", icon: "✉" },
  { href: "/admin/institutions/", label: "Institutions", icon: "🏫" },
  { href: "/admin/payments/", label: "Payments", icon: "💳" },
  { href: "/admin/automation/", label: "Automation", icon: "⚙" },
  { href: "/admin/social/", label: "Social", icon: "📣" },
  { href: "/admin/feature-flags/", label: "Flags", icon: "🚩" },
  { href: "/admin/tracking/", label: "Tracking", icon: "🎯" },
  { href: "/admin/settings/", label: "Settings", icon: "🛠" },
];

const isActive = (href: string) => (href === "/admin/" ? path === "/admin/" : path.startsWith(href));
---

<nav class="admin-nav" aria-label="Admin sections">
  <div class="admin-nav-inner">
    <span class="admin-nav-title" aria-hidden="true">Admin</span>
    <div class="admin-nav-scroll">
      {links.map((link) => (
        <a class="admin-nav-link" href={link.href} aria-current={isActive(link.href) ? "page" : undefined}>
          <span aria-hidden="true">{link.icon}</span>
          <span>{link.label}</span>
        </a>
      ))}
    </div>
    <a class="admin-nav-site" href="/" target="_blank" rel="noopener">View site ↗</a>
  </div>
</nav>

<style>
  .admin-nav {
    position: sticky;
    top: 68px;
    z-index: 45;
    margin: 0 0 18px;
    padding: 8px 0;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }

  .admin-nav-inner {
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: 1480px;
    margin-inline: auto;
    padding-inline: 16px;
  }

  .admin-nav-title {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    flex: 0 0 auto;
  }

  .admin-nav-scroll {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    padding: 2px 2px 4px;
    scrollbar-width: thin;
    flex: 1 1 auto;
    -webkit-overflow-scrolling: touch;
  }

  .admin-nav-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex: 0 0 auto;
    padding: 8px 12px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink-soft);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .admin-nav-link:hover {
    text-decoration: none;
    background: var(--brand-soft);
    border-color: #c9dcf5;
    color: var(--brand);
  }

  .admin-nav-link[aria-current="page"] {
    background: var(--brand);
    border-color: var(--brand);
    color: #fff;
  }

  .admin-nav-site {
    flex: 0 0 auto;
    font-size: 0.85rem;
    font-weight: 700;
    white-space: nowrap;
  }

  @media (max-width: 780px) {
    .admin-nav {
      top: 60px;
      margin-inline: -16px;
      padding: 6px 0;
    }

    .admin-nav-title,
    .admin-nav-site {
      display: none;
    }

    .admin-nav-link {
      padding: 7px 10px;
      font-size: 0.8rem;
    }
  }
</style>
