---
type Props = {
  gated?: boolean;
}

const { gated = true } = Astro.props;

const categories = [
  { label: "Latest Jobs", slug: "latest-jobs", icon: "💼", tone: "blue" },
  { label: "Results", slug: "results", icon: "🏆", tone: "green" },
  { label: "Admit Card", slug: "admit-card", icon: "🎫", tone: "amber" },
  { label: "Answer Key", slug: "answer-key", icon: "🔑", tone: "violet" },
  { label: "Exam Date", slug: "exam-date", icon: "🗓️", tone: "rose" },
  { label: "Admission", slug: "admission", icon: "🎓", tone: "cyan" },
  { label: "Syllabus", slug: "syllabus", icon: "📚", tone: "indigo" },
  { label: "Scholarship", slug: "scholarship", icon: "🎁", tone: "teal" },
  { label: "Career", slug: "career", icon: "💼", tone: "cyan" },
  { label: "States", slug: "states", icon: "📍", tone: "green" },
  { label: "Exams", slug: "exams", icon: "📚", tone: "blue" },
  { label: "Scholarships", slug: "scholarships", icon: "🎁", tone: "teal" }
];
---

<div class="auth-gate" id="auth-gate" data-gated={String(gated)}>
  <div class="auth-gate-wall" id="auth-gate-wall" hidden>
    <div class="categories-banner">
      <div class="container">
        {categories.map((category) => (
          <a 
            class="category-banner-item" 
            href={`/category/${category.slug}/`}
            style="display: inline-block; margin: 0 8px; padding: 8px 12px; border-radius: 20px; text-decoration: none; font-weight: 600; transition: all 0.2s ease"
          >
            <span class="category-icon" style="margin-right: 6px; font-size: 1.2em;">{category.icon}</span>
            <span class="category-label">{category.label}</span>
          </a>
        ))}
      </div>
    </div>
    <div class="auth-gate-card">
      <span class="brand-mark" aria-hidden="true">FE</span>
      <h2>Sign in to continue</h2>
      <p class="muted">FollowExam shows jobs, scholarships, institutions and career tools inside your account.</p>
      <a class="btn btn-primary" id="auth-gate-signin" href="/login/">Sign in or create an account</a>
      <p class="small muted" style="margin:12px 0 0">
        New here? Creating an account is free and takes less than a minute.
      </p>
    </div>
  </div>
  <div class="auth-gate-content" id="auth-gate-content">
    <slot />
  </div>
</div>

<noscript>
  <style>
    .auth-gate-content {
      visibility: visible !important;
    }
  </style>
</noscript>

<script>
  import { firebaseConfigured } from "../lib/firebase";
  import { watchAuth } from "../lib/auth";
  import { currentUser } from "firebase/auth";

  const gate = document.querySelector<HTMLElement>("#auth-gate");
  const content = document.querySelector<HTMLElement>("#auth-gate-content");
  const wall = document.querySelector<HTMLElement>("#auth-gate-wall");
  const signIn = document.querySelector<HTMLAnchorElement>("#auth-gate-signin");
  const gated = gate?.dataset.gated !== "false";

  const next = `${window.location.pathname}${window.location.search}${window.location.hash}`;
  if (signIn && next !== "/") signIn.href = `/login/?next=${encodeURIComponent(next)}`;

  function reveal() {
    if (gate) gate.dataset.ready = "true";
    if (wall) wall.hidden = true;
    if (content) content.hidden = false;
  }

  function block() {
    if (!gated) {
      reveal();
      return;
    }
    if (gate) gate.dataset.ready = "blocked";
    if (content) content.hidden = true;
    if (wall) wall.hidden = false;
    // Send the visitor to the login screen and bring them back afterwards.
    const target = `/login/?next=${encodeURIComponent(next)}`;
    window.setTimeout(() => window.location.replace(target), 1200);
  }

  const maybeReveal = () => {
    if (!firebaseConfigured || !currentUser()) {
      if (!gated) return;
      block();
      return;
    }
    reveal();
  };

  maybeReveal();
  watchAuth((user) => {
    if (user) reveal();
    else block();
  });
</script>