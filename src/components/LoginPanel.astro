---
/**
 * Shared sign-in / sign-up panel.
 * Used on the home page and on /login/.
 */
type Props = {
  /** Redirect to `?next=` (or `/`) as soon as the user is signed in. */
  redirectOnSignIn?: boolean;
  heading?: string;
  intro?: string;
  /** Heading level. Use 2 when the page already has its own h1. */
  headingLevel?: 1 | 2;
};

const {
  redirectOnSignIn = false,
  heading = "Welcome to FollowExam",
  intro = "Sign in to see government jobs, scholarships, institutions and your personal career roadmap.",
  headingLevel = 1,
} = Astro.props;

const HeadingTag = headingLevel === 2 ? "h2" : "h1";
---

<section class="auth-screen" data-auth-screen data-redirect={String(redirectOnSignIn)}>
  <div class="auth-card">
    <div class="auth-brand">
      <span class="brand-mark" aria-hidden="true">FE</span>
      <span>
        <strong>FollowExam</strong>
        <small>Every exam. One account.</small>
      </span>
    </div>

    <HeadingTag>{heading}</HeadingTag>
    <p class="muted">{intro}</p>

    <div class="auth-tabs" role="tablist" aria-label="Sign-in method">
      <button type="button" role="tab" aria-selected="true" data-auth-tab="google">Google</button>
      <button type="button" role="tab" aria-selected="false" data-auth-tab="email">Email</button>
      <button type="button" role="tab" aria-selected="false" data-auth-tab="phone">Phone</button>
    </div>

    <div class="form-message" data-auth-message role="status"></div>

    <div data-auth-panel="google">
      <button class="btn btn-outline btn-block" type="button" id="google-signin">
        Continue with Google
      </button>
      <p class="small muted auth-hint">Use any Google account. Your name and email are stored only to run your profile.</p>
    </div>

    <div data-auth-panel="email" hidden>
      <form id="email-form" class="form-grid">
        <div class="field" data-name-field hidden>
          <label for="auth-name">Full name</label>
          <input class="input" id="auth-name" type="text" autocomplete="name" placeholder="Your full name" />
        </div>
        <div class="field">
          <label for="auth-email">Email address</label>
          <input class="input" id="auth-email" type="email" autocomplete="email" placeholder="you@example.com" required />
        </div>
        <div class="field">
          <label for="auth-password">Password</label>
          <input
            class="input"
            id="auth-password"
            type="password"
            autocomplete="current-password"
            placeholder="At least 6 characters"
            minlength="6"
            required
          />
        </div>
        <button class="btn btn-primary btn-block" type="submit" id="email-submit">Sign in</button>
      </form>
      <p class="auth-switch">
        <button class="link-button" type="button" id="email-forgot">Forgot password?</button>
      </p>
      <p class="auth-switch">
        <span id="email-mode-text">New to FollowExam?</span>
        <button class="link-button" type="button" id="email-mode-toggle">Create an account</button>
      </p>
    </div>

    <div data-auth-panel="phone" hidden>
      <form id="phone-form" class="form-grid">
        <div class="field">
          <label for="auth-phone">Mobile number</label>
          <input
            class="input"
            id="auth-phone"
            type="tel"
            autocomplete="tel"
            placeholder="+91XXXXXXXXXX"
            required
          />
        </div>
        <button class="btn btn-primary btn-block" type="submit" id="phone-send">Send verification code</button>
      </form>

      <form id="otp-form" class="form-grid" hidden>
        <div class="field">
          <label for="auth-otp">Verification code</label>
          <input class="input" id="auth-otp" inputmode="numeric" autocomplete="one-time-code" maxlength="6" required />
        </div>
        <button class="btn btn-primary btn-block" type="submit">Verify and sign in</button>
      </form>

      <div id="recaptcha-container"></div>
      <p class="small muted auth-hint">
        Enter the number with the country code, for example +919876543210. Phone sign-in requires Firebase phone
        authentication to be enabled for the project.
      </p>
    </div>

    <p class="auth-legal small muted">
      By continuing you agree to our <a href="/privacy/">Privacy Policy</a> and
      <a href="/disclaimer/">Disclaimer</a>. Your profile data is stored in your own account and can be edited or
      deleted at any time.
    </p>
  </div>
</section>

<script>
  import {
    confirmPhoneCode,
    friendlyAuthError,
    requestPasswordReset,
    signInWithEmail,
    signInWithGoogle,
    signUpWithEmail,
    startPhoneSignIn,
  } from "../lib/auth";
  import { loadProfile, saveProfile } from "../lib/profile";
  import type { ConfirmationResult } from "firebase/auth";

  const screen = document.querySelector<HTMLElement>("[data-auth-screen]");
  const message = document.querySelector<HTMLElement>("[data-auth-message]");
  const tabs = [...document.querySelectorAll<HTMLButtonElement>("[data-auth-tab]")];
  const panels = [...document.querySelectorAll<HTMLElement>("[data-auth-panel]")];

  function show(text: string, type: "error" | "success" | "info" = "info") {
    if (!message) return;
    message.textContent = text;
    message.className = `form-message show ${type}`;
  }

  function setBusy(button: HTMLButtonElement | null, busy: boolean, label?: string) {
    if (!button) return;
    button.disabled = busy;
    if (label) button.textContent = busy ? "Please wait…" : label;
  }

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      tabs.forEach((item) => item.setAttribute("aria-selected", String(item === tab)));
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.authPanel !== tab.dataset.authTab;
      });
    });
  });

  async function finish(user: Parameters<typeof saveProfile>[0]) {
    try {
      const existing = await loadProfile(user);
      if (!existing) {
        await saveProfile(user, {
          name: user.displayName || user.email?.split("@")[0] || "Student",
          email: user.email || "",
          phone: user.phoneNumber || "",
        });
      }
    } catch {
      /* Profile creation is best-effort; sign-in still succeeds. */
    }

    if (screen?.dataset.redirect === "true") {
      const params = new URLSearchParams(window.location.search);
      const next = params.get("next") || "/";
      const safe = next.startsWith("/") && !next.startsWith("//") ? next : "/";
      window.location.replace(safe);
    }
  }

  /* ------------------------------- Google ------------------------------- */
  document.querySelector<HTMLButtonElement>("#google-signin")?.addEventListener("click", async (event) => {
    const button = event.currentTarget as HTMLButtonElement;
    setBusy(button, true, "Continue with Google");
    show("Opening Google sign-in…", "info");
    try {
      const user = await signInWithGoogle();
      show("Signed in. Loading your dashboard…", "success");
      await finish(user);
    } catch (error) {
      show(friendlyAuthError(error), "error");
    } finally {
      setBusy(button, false, "Continue with Google");
    }
  });

  /* -------------------------------- Email -------------------------------- */
  const emailForm = document.querySelector<HTMLFormElement>("#email-form");
  const nameField = document.querySelector<HTMLElement>("[data-name-field]");
  const emailSubmit = document.querySelector<HTMLButtonElement>("#email-submit");
  const modeText = document.querySelector<HTMLElement>("#email-mode-text");
  const modeToggle = document.querySelector<HTMLButtonElement>("#email-mode-toggle");
  let emailMode: "signin" | "signup" = "signin";

  modeToggle?.addEventListener("click", () => {
    emailMode = emailMode === "signin" ? "signup" : "signin";
    const signup = emailMode === "signup";
    if (nameField) nameField.hidden = !signup;
    if (emailSubmit) emailSubmit.textContent = signup ? "Create account" : "Sign in";
    if (modeText) modeText.textContent = signup ? "Already have an account?" : "New to FollowExam?";
    if (modeToggle) modeToggle.textContent = signup ? "Sign in instead" : "Create an account";
    const password = document.querySelector<HTMLInputElement>("#auth-password");
    if (password) password.autocomplete = signup ? "new-password" : "current-password";
    show("", "info");
  });

  emailForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const email = document.querySelector<HTMLInputElement>("#auth-email")?.value.trim() || "";
    const password = document.querySelector<HTMLInputElement>("#auth-password")?.value || "";
    const name = document.querySelector<HTMLInputElement>("#auth-name")?.value.trim() || "";

    if (!email || !password) {
      show("Enter your email and password.", "error");
      return;
    }

    setBusy(emailSubmit, true, emailMode === "signup" ? "Create account" : "Sign in");
    show(emailMode === "signup" ? "Creating your account…" : "Signing in…", "info");
    try {
      const user =
        emailMode === "signup"
          ? await signUpWithEmail(email, password, name)
          : await signInWithEmail(email, password);
      show("Signed in. Loading your dashboard…", "success");
      await finish(user);
    } catch (error) {
      show(friendlyAuthError(error), "error");
    } finally {
      setBusy(emailSubmit, false, emailMode === "signup" ? "Create account" : "Sign in");
    }
  });

  document.querySelector("#email-forgot")?.addEventListener("click", async () => {
    const email = document.querySelector<HTMLInputElement>("#auth-email")?.value.trim() || "";
    if (!email) {
      show("Enter your email address above, then press “Forgot password?”.", "error");
      document.querySelector<HTMLInputElement>("#auth-email")?.focus();
      return;
    }
    try {
      show("Sending a password reset link…", "info");
      await requestPasswordReset(email);
      show(`Password reset link sent to ${email}. Check your inbox and spam folder.`, "success");
    } catch (error) {
      show(friendlyAuthError(error), "error");
    }
  });

  /* -------------------------------- Phone -------------------------------- */
  const phoneForm = document.querySelector<HTMLFormElement>("#phone-form");
  const otpForm = document.querySelector<HTMLFormElement>("#otp-form");
  const phoneSend = document.querySelector<HTMLButtonElement>("#phone-send");
  let confirmation: ConfirmationResult | null = null;

  phoneForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const phone = document.querySelector<HTMLInputElement>("#auth-phone")?.value.trim() || "";
    if (!/^\+[1-9]\d{7,14}$/.test(phone)) {
      show("Enter the number in international format, for example +919876543210.", "error");
      return;
    }
    setBusy(phoneSend, true, "Send verification code");
    show("Sending the verification code…", "info");
    try {
      confirmation = await startPhoneSignIn(phone, "recaptcha-container");
      if (otpForm) otpForm.hidden = false;
      show("Code sent. Enter the 6-digit code from the SMS.", "success");
    } catch (error) {
      show(friendlyAuthError(error), "error");
    } finally {
      setBusy(phoneSend, false, "Send verification code");
    }
  });

  otpForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const code = document.querySelector<HTMLInputElement>("#auth-otp")?.value.trim() || "";
    if (!confirmation) {
      show("Request a verification code first.", "error");
      return;
    }
    if (!/^\d{6}$/.test(code)) {
      show("Enter the 6-digit code from the SMS.", "error");
      return;
    }
    show("Verifying the code…", "info");
    try {
      const user = await confirmPhoneCode(confirmation, code);
      show("Signed in. Loading your dashboard…", "success");
      await finish(user);
    } catch (error) {
      show(friendlyAuthError(error), "error");
    }
  });
</script>
