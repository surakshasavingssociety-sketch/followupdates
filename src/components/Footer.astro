---
import { CATEGORY_META, SITE } from "../lib/constants";
import SubscribeForm from "./SubscribeForm.astro";

const year = new Date().getFullYear();
const categories = Object.values(CATEGORY_META);
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a class="brand" href="/" style="color:#fff">
          <span class="brand-mark" aria-hidden="true">FE</span>
          <span>
            {SITE.name}
            <small style="color:rgba(255,255,255,.5)">Every exam. One account.</small>
          </span>
        </a>
        <p style="margin-top:14px;max-width:320px">
          Government jobs, results, admit cards, exam dates, admissions, scholarships and career guidance — all inside
          one free account.
        </p>
        <p class="footer-disclaimer">
          FollowExam is an independent information portal. We are not affiliated with any government department, board
          or commission. Always verify the official notification before applying.
        </p>
      </div>

      <div>
        <h2>Explore</h2>
        <a href="/jobs/">All updates</a>
        <a href="/scholarships/">Scholarships</a>
        <a href="/institutions/">Institutions</a>
        <a href="/exams/">Exam database</a>
        <a href="/states/">State-wise exams</a>
<a href="/government-services/">Government services</a>
<a href="/open-schooling/">Open schooling</a>
<a href="/library/">Digital library</a>
        <a href="/calendar/">Exam calendar</a>
      </div>

      <div>
        <h2>Your account</h2>
        <a href="/profile/">My profile</a>
        <a href="/career/">Career roadmap</a>
        <a href="/account/">Saved updates</a>
        <a href="/login/">Sign in</a>
        {categories.slice(0, 3).map((category) => (
          <a href={`/category/${category.slug}/`}>{category.label}</a>
        ))}
      </div>

      <div>
        <h2>Follow us</h2>
        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:8px">
          <a href="https://t.me/followexamupdates" target="_blank" rel="noopener" class="btn btn-sm" style="background:#0088cc;color:#fff">Telegram</a>
          <a href="https://wa.me/919999999999" target="_blank" rel="noopener" class="btn btn-sm" style="background:#25d366;color:#fff">WhatsApp</a>
          <a href="https://twitter.com/followexam" target="_blank" rel="noopener" class="btn btn-sm" style="background:#1da1f2;color:#fff">X (Twitter)</a>
          <a href="https://instagram.com/followexam" target="_blank" rel="noopener" class="btn btn-sm" style="background:#e1306c;color:#fff">Instagram</a>
          <a href="https://youtube.com/followexam" target="_blank" rel="noopener" class="btn btn-sm" style="background:#ff0000;color:#fff">YouTube</a>
        </div>
      </div>

      <div id="alerts">
        <h2>Daily email alerts</h2>
        <SubscribeForm compact source="footer" />
        {SITE.telegram && (
          <p style="margin-top:12px">
            <a href={SITE.telegram} target="_blank" rel="noopener" style="color:#ffc45c;font-weight:700">
              Join us on Telegram →
            </a>
          </p>
        )}
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {year} {SITE.name}. All rights reserved.</span>
      <span>
        <a href="/about/" style="display:inline">About</a> ·
        <a href="/contact/" style="display:inline">Contact</a> ·
        <a href="/privacy/" style="display:inline">Privacy</a> ·
        <a href="/disclaimer/" style="display:inline">Disclaimer</a>
      </span>
    </div>
  </div>
</footer>
