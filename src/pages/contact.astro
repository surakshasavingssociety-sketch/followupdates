---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../lib/constants";
---

<BaseLayout
  title="Contact FollowExam"
  description="Contact FollowExam for a correction, a new notification, a copyright request or feedback."
  gated={false}
>
  <section class="section-tight" style="padding-top:34px">
    <div class="container">
      <div class="breadcrumb" style="padding:0 0 14px">
        <a href="/">Home</a><span>/</span><span>Contact</span>
      </div>

      <div class="grid-2" style="align-items:start">
        <article class="prose">
          <h1>Contact us</h1>
          <p>
            For a correction, a new notification, a copyright request or feedback, write to the email below. We usually
            reply within one or two working days.
          </p>

          <h2>Email</h2>
          <p>
            <a href={`mailto:${SITE.email}`} style="font-weight:700;font-size:1.05rem">{SITE.email}</a>
          </p>

          <h2>What to write about</h2>
          <ul>
            <li><strong>Correction:</strong> if a date, fee, vacancy count or link is wrong, send the post URL.</li>
            <li><strong>New notification:</strong> send the official source link and a short note.</li>
            <li><strong>Copyright / removal:</strong> include your role, organisation and the affected URL.</li>
            <li><strong>Alerts:</strong> for an unsubscribe or Telegram issue, send your registered email address.</li>
          </ul>

          <h2>Important</h2>
          <p class="small muted">
            FollowExam is not part of any government recruitment process. For a problem with an application, fee
            payment, admit card or result, contact the official department only.
          </p>
        </article>

        <div class="panel">
          <h2 style="font-size:1.2rem">Quick message</h2>
          <p class="muted small">
            Submitting this form opens your email app with the message already filled in, so you can send it from your
            own email account.
          </p>

          <form id="contact-form" class="form-grid">
            <div class="field">
              <label for="contact-name">Your name</label>
              <input class="input" id="contact-name" name="name" autocomplete="name" required />
            </div>
            <div class="field">
              <label for="contact-email">Your email</label>
              <input class="input" id="contact-email" name="email" type="email" autocomplete="email" required />
            </div>
            <div class="field">
              <label for="contact-topic">Topic</label>
              <select class="select" id="contact-topic" name="topic">
                <option>Correction request</option>
                <option>New notification</option>
                <option>Copyright / removal</option>
                <option>Alert / unsubscribe</option>
                <option>Other</option>
              </select>
            </div>
            <div class="field">
              <label for="contact-message">Message</label>
              <textarea class="textarea" id="contact-message" name="message" required></textarea>
            </div>
            <button class="btn btn-primary" type="submit">Open email app</button>
          </form>

          <p class="form-message" id="contact-status" role="status"></p>

          <div style="border-top:1px solid var(--line);margin-top:18px;padding-top:14px">
            <p class="small muted" style="margin:0">
              Or email directly:
              <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ contactEmail: SITE.email }}>
  const form = document.querySelector("#contact-form");
  const status = document.querySelector("#contact-status");

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const name = String(data.get("name") || "").trim();
    const email = String(data.get("email") || "").trim();
    const topic = String(data.get("topic") || "").trim();
    const message = String(data.get("message") || "").trim();

    const subject = `[FollowExam] ${topic} — ${name}`;
    const body = [`Name: ${name}`, `Email: ${email}`, `Topic: ${topic}`, "", message].join("\n");

    window.location.href = `mailto:${contactEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    if (status) {
      status.textContent = "Your email app is opening. If it does not, write to the email address above.";
      status.className = "form-message show info";
    }
  });
</script>
