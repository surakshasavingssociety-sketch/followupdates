---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../lib/constants";

const updated = "1 November 2026";
---

<BaseLayout
  title="Disclaimer"
  description="FollowExam is not affiliated with any government department. Verify the official notification before applying."
  gated={false}
>
  <section class="section-tight" style="padding-top:34px">
    <div class="container">
      <div class="breadcrumb" style="padding:0 0 14px">
        <a href="/">Home</a><span>/</span><span>Disclaimer</span>
      </div>

      <article class="prose">
        <h1>Disclaimer</h1>
        <p class="small muted">Last updated: {updated}</p>

        <div class="demo-warning" style="margin-bottom:20px">
          <strong>Important:</strong> FollowExam is an independent information portal. It is not affiliated, endorsed or
          authorised by any government department, commission, board or recruitment agency.
        </div>

        <h2>Accuracy of information</h2>
        <p>
          We aim to publish every update from an official source. Even so, dates, vacancy counts, fees, eligibility and
          links can contain errors, or the official notification can change later. Always
          <strong>verify on the official website</strong> before you apply, pay a fee or download a document.
        </p>

        <h2>No guarantee</h2>
        <p>
          Information on FollowExam is provided "as is" and "as available". We do not guarantee any job, admission,
          result, rank or selection. Every decision you take is your own responsibility.
        </p>

        <h2>Official links</h2>
        <p>
          Every post includes a link to the official website or notification PDF. Apply, pay fees, download admit cards
          and check results only on the official portal. FollowExam does not process any payment or application.
        </p>

        <h2>Third-party content</h2>
        <p>
          Some links take you to external websites. FollowExam is not responsible for their content, availability or
          security. Their own terms and privacy policies apply.
        </p>

        <h2>Copyright and removal</h2>
        <p>
          We do not copy copyrighted content from other websites. Our posts contain original summaries and links to
          official sources. If you believe an entry uses your copyrighted material, write to
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a> and we will remove or correct it after a valid request.
        </p>

        <h2>External link policy</h2>
        <p>
          We prefer official government domains, public notification feeds and verified recruitment portals. We do not
          promote third-party paid services or coaching material.
        </p>

        <h2>Liability</h2>
        <p>
          FollowExam and its operators are not liable for any direct, indirect, incidental or consequential loss arising
          from the use of this site or its information. This disclaimer applies to the maximum extent permitted under
          Indian law.
        </p>

        <h2>Contact</h2>
        <p>
          For any question about this disclaimer or our content: <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
