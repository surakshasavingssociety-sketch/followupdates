---
import BaseLayout from "../../layouts/BaseLayout.astro";
import JobCard from "../../components/JobCard.astro";
import SubscribeForm from "../../components/SubscribeForm.astro";
import { CATEGORY_META, SITE } from "../../lib/constants";
import { getExam, monthLabel, nextPhaseLabel } from "../../lib/exams";
import { formatDate, jobs } from "../../lib/jobs";
import type { Job } from "../../lib/types";

export function getStaticPaths() {
  return jobs.map((job) => ({
    params: { slug: job.slug },
    props: { job },
  }));
}

type Props = { job: Job };
const { job } = Astro.props;

const meta = CATEGORY_META[job.category] || { label: job.category, tone: "blue", slug: "latest-jobs" };
const exam = job.examId ? getExam(job.examId) : undefined;
const related = jobs
  .filter((item) => item.id !== job.id && (item.category === job.category || item.state === job.state))
  .slice(0, 3);

const feeRows = [
  ["General / OBC", job.fee?.general ?? job.fee?.obc],
  ["SC / ST", job.fee?.scSt],
  ["Female", job.fee?.female],
].filter(([, value]) => value !== undefined && value !== null);

const importantDates =
  job.importantDates && job.importantDates.length
    ? job.importantDates
    : [
        { label: "Notification published", date: job.postDate },
        { label: "Application starts", date: job.applyStart },
        { label: "Last date to apply", date: job.applyEnd },
        { label: "Exam date", date: job.examDate },
      ].filter((row) => row.date);

const officialLinks =
  job.officialLinks && job.officialLinks.length
    ? job.officialLinks
    : [
        { label: "Official notification", url: job.notificationUrl },
        { label: "Official website", url: job.officialUrl },
      ];

const officialHost = (() => {
  try {
    return new URL(job.officialUrl).hostname.replace(/^www\./, "");
  } catch {
    return "official website";
  }
})();

const schema = {
  "@context": "https://schema.org",
  "@type": "JobPosting",
  title: job.title,
  description: job.summary,
  datePosted: job.postDate,
  ...(job.applyEnd ? { validThrough: `${job.applyEnd}T23:59:59+05:30` } : {}),
  hiringOrganization: {
    "@type": "Organization",
    name: job.organization,
    sameAs: job.officialUrl,
  },
  jobLocation: {
    "@type": "Place",
    address: {
      "@type": "PostalAddress",
      addressCountry: "IN",
      addressRegion: job.state === "All India" ? "India" : job.state,
    },
  },
  ...(job.vacancies ? { totalJobOpenings: job.vacancies } : {}),
  ...(job.salary ? { baseSalary: { "@type": "MonetaryAmount", currency: "INR", value: job.salary } } : {}),
  directApply: false,
  url: `${SITE.url}/jobs/${job.slug}/`,
};
---

<BaseLayout
  title={job.title}
  description={`${job.organization} — ${job.summary.slice(0, 150)}`}
  type="article"
  schema={schema}
>
  <div class="container breadcrumb">
    <a href="/">Dashboard</a>
    <span>/</span>
    <a href="/jobs/">All updates</a>
    <span>/</span>
    <a href={`/category/${meta.slug}/`}>{meta.label}</a>
  </div>

  <div class="container detail-layout">
    <article class="panel detail-header">
      {job.demo && (
        <div class="demo-warning">
          <strong>Sample listing:</strong> this entry shows the format of a fully analysed notification. Confirm every
          detail on the official notification before applying.
        </div>
      )}

      <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
        <span class:list={["badge", `badge-${meta.tone}`]}>{meta.label}</span>
        <span class="badge badge-muted">{job.state || "All India"}</span>
        {job.vacancies ? <span class="badge badge-blue">{job.vacancies.toLocaleString("en-IN")} posts</span> : null}
      </div>

      <h1>{job.title}</h1>
      <div class="detail-sub">
        <span>🏛 {job.organization}</span>
        <span>📅 Published {formatDate(job.postDate)}</span>
        <span>🔗 Source: {job.sourceName}</span>
      </div>

      <p class="detail-summary">{job.summary}</p>

      <div class="notification-cta">
        <a class="btn btn-primary" href={job.notificationUrl} target="_blank" rel="noopener nofollow">
          Open official notification ↗
        </a>
        <p>
          Every post on FollowExam carries the official notification link. Read the original PDF or notice before you
          apply, pay a fee or download a document.
        </p>
      </div>

      <div class="key-grid">
        <div class="key-item">
          <small>Application starts</small>
          <strong>{formatDate(job.applyStart)}</strong>
        </div>
        <div class="key-item">
          <small>Last date to apply</small>
          <strong style={job.applyEnd ? "color:var(--red)" : ""}>{formatDate(job.applyEnd)}</strong>
        </div>
        <div class="key-item">
          <small>Exam date</small>
          <strong>{formatDate(job.examDate)}</strong>
        </div>
        <div class="key-item">
          <small>Qualification</small>
          <strong>{job.qualification?.join(", ") || "See notification"}</strong>
        </div>
        <div class="key-item">
          <small>Age limit</small>
          <strong>
            {job.age?.min || job.age?.max
              ? `${job.age?.min ?? "—"} – ${job.age?.max ?? "—"} years`
              : "See notification"}
          </strong>
        </div>
        <div class="key-item">
          <small>Salary / pay scale</small>
          <strong>{job.salary || "See notification"}</strong>
        </div>
      </div>

      {job.highlights?.length ? (
        <section class="detail-section">
          <h2>What the notification says</h2>
          <ul class="highlight-list">
            {job.highlights.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      ) : null}

      {importantDates.length ? (
        <section class="detail-section">
          <h2>Important dates</h2>
          <div class="table-wrap">
            <table class="date-table">
              <thead>
                <tr><th>Event</th><th>Date</th></tr>
              </thead>
              <tbody>
                {importantDates.map((row) => (
                  <tr>
                    <td>
                      {row.label}
                      {row.note ? <div class="small muted">{row.note}</div> : null}
                    </td>
                    <td>{row.date ? formatDate(row.date) : "To be announced"}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      ) : null}

      {job.posts?.length ? (
        <section class="detail-section">
          <h2>Posts and vacancies</h2>
          <div class="table-wrap">
            <table>
              <thead>
                <tr><th>Post</th><th>Vacancies</th><th>Qualification</th></tr>
              </thead>
              <tbody>
                {job.posts.map((post) => (
                  <tr>
                    <td>
                      {post.name}
                      {post.note ? <div class="small muted">{post.note}</div> : null}
                    </td>
                    <td>{post.vacancies ? post.vacancies.toLocaleString("en-IN") : "—"}</td>
                    <td>{post.qualification || "See notification"}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      ) : null}

      <section class="detail-section">
        <h2>Eligibility</h2>
        {job.eligibility?.length ? (
          <ul class="check-list">
            {job.eligibility.map((item) => <li>{item}</li>)}
          </ul>
        ) : (
          <p class="muted">
            Qualification: {job.qualification?.join(", ") || "as stated in the official notification"}. Age limit:{" "}
            {job.age?.min || job.age?.max
              ? `${job.age?.min ?? "—"} to ${job.age?.max ?? "—"} years${job.age?.note ? ` — ${job.age.note}` : ""}`
              : "as stated in the official notification"}.
          </p>
        )}
      </section>

      {job.selectionProcess?.length ? (
        <section class="detail-section">
          <h2>Selection process</h2>
          <ol class="step-list">
            {job.selectionProcess.map((step) => <li>{step}</li>)}
          </ol>
        </section>
      ) : null}

      {job.howToApply?.length ? (
        <section class="detail-section">
          <h2>How to apply</h2>
          <ol class="step-list">
            {job.howToApply.map((step) => <li>{step}</li>)}
          </ol>
        </section>
      ) : (
        <section class="detail-section">
          <h2>How to apply</h2>
          <ol class="step-list">
            <li>Open the official notification link on this page.</li>
            <li>Read the eligibility, dates and fee carefully.</li>
            <li>Complete the online form on the official portal.</li>
            <li>Save the application receipt and payment confirmation.</li>
          </ol>
        </section>
      )}

      {job.documents?.length ? (
        <section class="detail-section">
          <h2>Documents to keep ready</h2>
          <ul class="check-list">
            {job.documents.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      ) : null}

      {feeRows.length > 0 && (
        <section class="detail-section">
          <h2>Application fee</h2>
          <div class="table-wrap">
            <table>
              <thead>
                <tr><th>Category</th><th>Fee</th></tr>
              </thead>
              <tbody>
                {feeRows.map(([label, value]) => (
                  <tr>
                    <td>{label}</td>
                    <td>{value === 0 ? "No fee" : `₹${Number(value).toLocaleString("en-IN")}`}</td>
                  </tr>
                ))}
                {job.fee?.paymentMode && (
                  <tr><td>Payment mode</td><td>{job.fee.paymentMode}</td></tr>
                )}
              </tbody>
            </table>
          </div>
        </section>
      )}

      <section class="detail-section">
        <h2>Official links</h2>
        <ul class="link-list">
          {officialLinks.map((link) => (
            <li>
              <a href={link.url} target="_blank" rel="noopener nofollow">
                <span>{link.label}</span>
                <span aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="small muted" style="margin-top:10px">
          Source host: {officialHost}. FollowExam does not accept applications, fees or documents on behalf of any
          department.
        </p>
      </section>

      {related.length > 0 && (
        <section class="detail-section">
          <h2>Related updates</h2>
          <div class="grid-3">
            {related.map((item) => <JobCard job={item} />)}
          </div>
        </section>
      )}
    </article>

    <aside>
      <div class="sidebar-card">
        <h3>Official notification</h3>
        <p>The original notice is the final source for every detail on this page.</p>
        <div class="sidebar-actions">
          <a class="btn btn-primary" href={job.notificationUrl} target="_blank" rel="noopener nofollow">
            Open notification ↗
          </a>
          <a class="btn btn-outline" href={job.officialUrl} target="_blank" rel="noopener nofollow">
            Official website ↗
          </a>
          <button
            class="btn btn-outline"
            type="button"
            data-save-job
            data-job-id={job.id}
            data-job-title={job.title}
          >
            ☆ Save this update
          </button>
          <button class="btn btn-ghost" type="button" data-share-job>Share</button>
        </div>
      </div>

      {exam ? (
        <div class="sidebar-card">
          <h3>{exam.name} cycle</h3>
          <p>The exam linked to this update and its usual schedule.</p>
          <div class="facts">
            <div><span>Next phase</span><strong>{nextPhaseLabel(exam)}</strong></div>
            <div><span>Notification</span><strong>{monthLabel(exam.cycle.notification)}</strong></div>
            <div><span>Exam</span><strong>{monthLabel(exam.cycle.exam)}</strong></div>
            <div><span>Result</span><strong>{monthLabel(exam.cycle.result)}</strong></div>
          </div>
          <div class="sidebar-actions" style="margin-top:12px">
            <a class="btn btn-outline" href={`/exams/${exam.slug}/`}>Full exam page →</a>
          </div>
        </div>
      ) : null}

      <div class="sidebar-card">
        <h3>Quick facts</h3>
        <div class="facts">
          <div><span>Category</span><strong>{meta.label}</strong></div>
          <div><span>State</span><strong>{job.state}</strong></div>
          <div><span>Vacancies</span><strong>{job.vacancies ? job.vacancies.toLocaleString("en-IN") : "—"}</strong></div>
          <div><span>Last date</span><strong>{formatDate(job.applyEnd)}</strong></div>
        </div>
      </div>

      <div class="sidebar-card">
        <h3>Daily alerts</h3>
        <p>Get matching updates in your inbox once a day.</p>
        <SubscribeForm compact source={`job-${job.slug}`} />
      </div>
    </aside>
  </div>
</BaseLayout>

<script>
  import { isJobSaved, toggleJobSaved, watchUser } from "../../lib/saved";
  import type { User } from "firebase/auth";

  let currentUser: User | null = null;
  const saveButton = document.querySelector<HTMLButtonElement>("[data-save-job]");
  const shareButton = document.querySelector<HTMLButtonElement>("[data-share-job]");
  const jobId = saveButton?.dataset.jobId || "";

  watchUser(async (user) => {
    currentUser = user;
    if (!saveButton || !jobId) return;
    const saved = await isJobSaved(jobId, user);
    paint(saved);
  });

  function paint(saved: boolean) {
    if (!saveButton) return;
    saveButton.textContent = saved ? "★ Saved" : "☆ Save this update";
    saveButton.classList.toggle("btn-primary", saved);
    saveButton.classList.toggle("btn-outline", !saved);
  }

  saveButton?.addEventListener("click", async () => {
    if (!jobId) return;
    saveButton.disabled = true;
    try {
      const saved = await toggleJobSaved(jobId, currentUser);
      paint(saved);
    } catch (error) {
      alert(error instanceof Error ? error.message : "Could not save this update.");
    } finally {
      saveButton.disabled = false;
    }
  });

  shareButton?.addEventListener("click", async () => {
    const data = { title: document.title, url: window.location.href };
    try {
      if (navigator.share) await navigator.share(data);
      else {
        await navigator.clipboard.writeText(window.location.href);
        shareButton.textContent = "Link copied!";
        setTimeout(() => (shareButton.textContent = "Share"), 1800);
      }
    } catch {
      /* user cancelled */
    }
  });
</script>
