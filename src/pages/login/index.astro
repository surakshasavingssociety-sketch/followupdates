---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LoginPanel from "../../components/LoginPanel.astro";
---

<BaseLayout
  title="Sign in or create your account"
  description="Sign in to FollowExam with Google, email or your mobile number to access government job notifications, scholarships, institutions and your career roadmap."
  noindex
  gated={false}
>
  <div class="container auth-page">
    <LoginPanel redirectOnSignIn={true} />
  </div>
</BaseLayout>

<script>
  import { watchAuth } from "../../lib/auth";
  import { resolveAccess } from "../../lib/roles";

  watchAuth(async (user) => {
    if (!user) return;
    const params = new URLSearchParams(window.location.search);
    const requested = params.get("next");
    const access = await resolveAccess(user);
    const fallback = access.kind === "admin" ? access.homePath : "/";
    const safe =
      requested && requested.startsWith("/") && !requested.startsWith("//") ? requested : fallback;
    window.location.replace(safe);
  });
</script>
