---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Public portfolio"
  description="A FollowExam member's public portfolio — skills, goals and links shared by the member."
  noindex
  gated={false}
>
  <section class="section-tight" style="padding-top:34px">
    <div class="container" style="max-width:820px">
      <div class="eyebrow">FollowExam member</div>
      <h1 style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;">Public portfolio</h1>

      <div id="pf-loading" class="panel">
        <p class="muted" style="margin:0">Loading portfolio…</p>
      </div>

      <div id="pf-missing" class="form-card hidden">
        <h2 style="font-size:1.7rem;margin:0 0 8px">Public portfolio</h2>
        <p class="muted small">Paste a portfolio link or member ID to open a shared portfolio.</p>
        <form id="pf-search-form" class="form-grid">
          <div class="field full">
            <label for="pf-search">Portfolio link or member ID</label>
            <input class="input" id="pf-search" placeholder="https://followupdates.web.app/portfolio/?u=…" required />
          </div>
          <div class="field full"><button class="btn btn-primary" type="submit">Open portfolio</button></div>
        </form>
        <p class="form-message" id="pf-search-message" role="status"></p>
      </div>

      <div id="pf-notfound" class="form-card hidden">
        <h2 style="font-size:1.7rem;margin:0 0 8px">Portfolio not found</h2>
        <p class="muted small">This portfolio is private, deleted or the link is incorrect.</p>
        <a class="btn btn-outline" href="/">Go to FollowExam</a>
      </div>

      <article id="pf-card" class="panel hidden">
        <div style="display:flex;gap:16px;align-items:center;flex-wrap:wrap">
          <span class="avatar" id="pf-avatar" aria-hidden="true">FE</span>
          <div style="flex:1;min-width:200px">
            <h2 style="font-size:clamp(1.5rem,3vw,2rem);margin:0" id="pf-name">Member</h2>
            <p class="muted" style="margin:4px 0 0" id="pf-headline"></p>
            <p class="small muted" style="margin:4px 0 0" id="pf-meta"></p>
          </div>
          <a class="btn btn-outline btn-sm" href="/">FollowExam</a>
        </div>

        <div style="margin-top:18px" id="pf-skills-wrap">
          <h2 style="font-size:1rem;margin:0 0 8px">Skills</h2>
          <div id="pf-skills" style="display:flex;gap:6px;flex-wrap:wrap"></div>
        </div>

        <div style="margin-top:18px" id="pf-links-wrap">
          <h2 style="font-size:1rem;margin:0 0 8px">Links</h2>
          <div style="display:flex;gap:8px;flex-wrap:wrap">
            <a class="btn btn-primary btn-sm hidden" id="pf-portfolio" target="_blank" rel="noopener noreferrer">Portfolio ↗</a>
            <a class="btn btn-outline btn-sm hidden" id="pf-resume" target="_blank" rel="noopener noreferrer">Resume / CV ↗</a>
          </div>
        </div>

        <p class="small muted" style="margin:20px 0 0">
          This page shows only the details the member chose to publish. Contact details are never shown.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>

<script>
  import { doc, getDoc } from "firebase/firestore";
  import { getFirebaseDb } from "../../lib/firebase";

  const loading = document.querySelector<HTMLElement>("#pf-loading");
  const missing = document.querySelector<HTMLElement>("#pf-missing");
  const notFound = document.querySelector<HTMLElement>("#pf-notfound");
  const card = document.querySelector<HTMLElement>("#pf-card");

  function show(target: HTMLElement | null) {
    [loading, missing, notFound, card].forEach((panel) => panel?.classList.add("hidden"));
    target?.classList.remove("hidden");
  }

  function initials(name: string) {
    return (
      name
        .split(/\s+/)
        .filter(Boolean)
        .slice(0, 2)
        .map((part) => part[0]?.toUpperCase() || "")
        .join("") || "FE"
    );
  }

  function extractUid(value: string): string {
    const trimmed = value.trim();
    if (!trimmed) return "";
    try {
      const url = new URL(trimmed, location.origin);
      const fromQuery = url.searchParams.get("u") || url.searchParams.get("uid");
      if (fromQuery) return fromQuery;
      const last = url.pathname.split("/").filter(Boolean).pop();
      if (last) return last;
    } catch {
      /* not a URL */
    }
    return trimmed;
  }

  function setText(id: string, value: string) {
    const element = document.querySelector<HTMLElement>(id);
    if (element) element.textContent = value;
  }

  function safeLink(value: unknown): string {
    const link = String(value || "").trim();
    if (!link) return "";
    try {
      const url = new URL(link);
      return url.protocol === "http:" || url.protocol === "https:" ? url.href : "";
    } catch {
      return "";
    }
  }

  function render(data: Record<string, any>) {
    const name = String(data.name || "FollowExam member");
    setText("#pf-name", name);
    setText("#pf-avatar", initials(name));

    const headline = String(data.headline || data.userStatus || "");
    const headlineEl = document.querySelector<HTMLElement>("#pf-headline");
    if (headlineEl) {
      headlineEl.textContent = headline;
      headlineEl.style.display = headline ? "" : "none";
    }

    const meta = [data.userStatus, data.educationLevel, data.stateName, data.organizationName]
      .map((value) => String(value || "").trim())
      .filter(Boolean)
      .filter((value, index, list) => list.indexOf(value) === index)
      .join(" · ");
    const metaEl = document.querySelector<HTMLElement>("#pf-meta");
    if (metaEl) {
      metaEl.textContent = meta;
      metaEl.style.display = meta ? "" : "none";
    }

    const skills = Array.isArray(data.skills) ? data.skills.map(String).filter(Boolean).slice(0, 40) : [];
    const skillsWrap = document.querySelector<HTMLElement>("#pf-skills-wrap");
    const skillsBox = document.querySelector<HTMLElement>("#pf-skills");
    if (skillsWrap && skillsBox) {
      skillsBox.innerHTML = "";
      for (const skill of skills) {
        const chip = document.createElement("span");
        chip.className = "badge badge-blue";
        chip.textContent = skill;
        skillsBox.appendChild(chip);
      }
      skillsWrap.style.display = skills.length ? "" : "none";
    }

    const portfolioUrl = safeLink(data.portfolio);
    const resumeUrl = safeLink(data.resumeUrl);
    const portfolioLink = document.querySelector<HTMLAnchorElement>("#pf-portfolio");
    const resumeLink = document.querySelector<HTMLAnchorElement>("#pf-resume");
    if (portfolioLink) {
      portfolioLink.href = portfolioUrl || "#";
      portfolioLink.classList.toggle("hidden", !portfolioUrl);
    }
    if (resumeLink) {
      resumeLink.href = resumeUrl || "#";
      resumeLink.classList.toggle("hidden", !resumeUrl);
    }
    const linksWrap = document.querySelector<HTMLElement>("#pf-links-wrap");
    if (linksWrap) linksWrap.style.display = portfolioUrl || resumeUrl ? "" : "none";

    show(card);
  }

  async function load(uid: string) {
    const db = getFirebaseDb();
    if (!db) {
      show(notFound);
      return;
    }
    if (!/^[A-Za-z0-9_-]{6,128}$/.test(uid)) {
      show(notFound);
      return;
    }
    show(loading);
    try {
      const snapshot = await getDoc(doc(db, "portfolios", uid));
      if (!snapshot.exists()) {
        show(notFound);
        return;
      }
      render(snapshot.data() as Record<string, any>);
    } catch {
      show(notFound);
    }
  }

  const initial = new URLSearchParams(location.search).get("u") || "";
  if (initial) load(initial);
  else show(missing);

  document.querySelector("#pf-search-form")?.addEventListener("submit", (event) => {
    event.preventDefault();
    const uid = extractUid(document.querySelector<HTMLInputElement>("#pf-search")?.value || "");
    if (!uid) {
      const message = document.querySelector<HTMLElement>("#pf-search-message");
      if (message) {
        message.textContent = "Enter a valid portfolio link or member ID.";
        message.className = "form-message show error";
      }
      return;
    }
    history.replaceState(null, "", `?u=${encodeURIComponent(uid)}`);
    load(uid);
  });
</script>
