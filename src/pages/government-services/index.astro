---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="Government services" description="E-district, scholarships, and government service links." gated={false}>
  <section class="section-tight">
    <div class="container">
      <div class="eyebrow" style="background:var(--brand-soft);color:var(--brand);border-color:transparent">Government services</div>
      <h1>Government services & e-district</h1>
      <p class="muted">Useful government portals for students, aspirants, teachers and faculty.</p>

      <div style="display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(260px,1fr))">
        <a class="panel" href="https://edistrict.gov.in/" target="_blank" rel="noopener" style="text-decoration:none">
          <h3>e-District</h3>
          <p class="small muted">State e-district services, certificates, applications.</p>
        </a>
        <a class="panel" href="https://scholarships.gov.in/" target="_blank" rel="noopener" style="text-decoration:none">
          <h3>National Scholarship Portal</h3>
          <p class="small muted">Central and state scholarships — apply online.</p>
        </a>
        <a class="panel" href="https://digilocker.gov.in/" target="_blank" rel="noopener" style="text-decoration:none">
          <h3>DigiLocker</h3>
          <p class="small muted">Digital document wallet for certificates and marksheets.</p>
        </a>
        <a class="panel" href="https://www.ugc.ac.in/" target="_blank" rel="noopener" style="text-decoration:none">
          <h3>UGC</h3>
          <p class="small muted">University Grants Commission — universities and colleges.</p>
        </a>
        <a class="panel" href="https://www.aicte-india.org/" target="_blank" rel="noopener" style="text-decoration:none">
          <h3>AICTE</h3>
          <p class="small muted">All India Council for Technical Education.</p>
        </a>
        <a class="panel" href="https://ncweb.du.ac.in/" target="_blank" rel="noopener" style="text-decoration:none">
          <h3>NCWEB</h3>
          <p class="small muted">Non-collegiate Women's Education Board.</p>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
