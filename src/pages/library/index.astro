---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="Library" description="Free government library books — direct PDF access." gated={false}>
  <section class="section-tight">
    <div class="container">
      <h1>Library</h1>
      <p class="muted">Government and public domain books — read directly in your browser.</p>
      <div style="display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(260px,1fr))">
        <div class="panel">
          <h3>CBSE Class 10</h3>
          <p class="small">Mathematics — NCERT</p>
          <a class="btn btn-outline btn-sm" href="https://ncert.nic.in/textbook/pdf/hemh1.pdf" target="_blank" rel="noopener">Read PDF →</a>
        </div>
        <div class="panel">
          <h3>UPSC CSAT</h3>
          <p class="small">Strategy & ethics — reference</p>
          <a class="btn btn-outline btn-sm" href="https://www.upsc.gov.in/" target="_blank" rel="noopener">Open source →</a>
        </div>
      </div>
      <p class="small muted" style="margin-top:14px">Full library features: user tracking, search, government-approved source only.</p>
    </div>
  </section>
</BaseLayout>
