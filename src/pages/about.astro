---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../lib/constants";

const schema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: `About ${SITE.name}`,
  url: `${SITE.url}/about/`,
  description: SITE.description,
};
---

<BaseLayout
  title="About FollowExam"
  description="FollowExam is a free, independent portal that brings official government job, exam and scholarship notifications into one account-based feed."
  schema={schema}
  gated={false}
>
  <section class="section-tight" style="padding-top:34px">
    <div class="container">
      <div class="breadcrumb" style="padding:0 0 14px">
        <a href="/">Home</a><span>/</span><span>About</span>
      </div>

      <article class="prose">
        <h1>About FollowExam</h1>
        <p>
          FollowExam is an independent, free information portal for Indian government jobs, board exams, entrance
          tests, results, admit cards, answer keys, exam dates, admissions, institutions and scholarships. Everything
          is organised in one account so you can follow what matters without jumping between websites.
        </p>

        <h2>What you get</h2>
        <ul>
          <li>Every published update carries a direct link to the official notification or notice.</li>
          <li>Notifications are analysed so dates, posts, eligibility, fees, selection stages and documents are readable in one place.</li>
          <li>Exam cycles, state pages, institutions and scholarship schemes are connected to the updates.</li>
          <li>A profile with your class, stream, state and career goal drives the recommendations and the career roadmap.</li>
          <li>Email alerts are sent one message at a time, never as a bulk mailing.</li>
        </ul>

        <h2>What we do not do</h2>
        <ul>
          <li>We are not affiliated with any government department, board or commission.</li>
          <li>We do not accept applications, collect fees or declare results on anyone's behalf.</li>
          <li>We do not copy text or images from other websites. Every summary is written for FollowExam and links back to the official source.</li>
          <li>We do not promise selection, a rank or a government job.</li>
        </ul>

        <h2>Content policy</h2>
        <p>
          Each update is published with an original summary, the analysed details and the official notification link.
          The original notification, PDF and application portal are always the final authority. If you spot an error,
          tell us through the <a href="/contact/">contact page</a> and we will correct it quickly.
        </p>

        <h2>Copyright</h2>
        <p>
          If you represent a government body or organisation and believe an entry uses your content incorrectly, write
          to us. We will remove or correct the content after a valid request.
        </p>

        <h2>How you can help</h2>
        <p>
          You can send us a new notification, report a mistake, or tell a friend about FollowExam. Daily email alerts are
          free.
        </p>

        <p class="small muted" style="margin-top:24px">
          Last updated: {new Date().toISOString().slice(0, 10)}
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
