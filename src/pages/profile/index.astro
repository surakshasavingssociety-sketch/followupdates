---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE } from "../../lib/constants";
import { CAREER_GOALS, EDUCATION_LEVELS, USER_CATEGORIES } from "../../lib/profile";
import { states } from "../../lib/states";

const streams = ["Science (PCM)", "Science (PCB)", "Science (PCMB)", "Commerce", "Arts / Humanities", "Engineering", "Medical", "Other"];
const interestOptions = [
  "Engineering",
  "Medical",
  "Civil Services",
  "Defence",
  "Banking",
  "Teaching",
  "Law",
  "Management",
  "Railways",
  "Research",
  "Sports",
  "Arts and design",
];
---

<BaseLayout
  title="My profile"
  description="Maintain your education level, state, career goal and interests to get personalised exam, scholarship and institution recommendations."
  noindex
>
  <section class="section-tight" style="padding-top:30px">
    <div class="container">
      <div class="breadcrumb" style="padding:0 0 14px">
        <a href="/">Dashboard</a><span>/</span><span>My profile</span>
      </div>

      <div class="section-head" style="margin-bottom:18px">
        <div>
          <div class="eyebrow">Your account</div>
          <h1 style="font-size:clamp(1.8rem,3.6vw,2.5rem)">My profile</h1>
          <p>
            This is the information FollowExam uses to recommend exams, scholarships, institutions and a career
            roadmap. You can change it at any time.
          </p>
        </div>
        <span class="badge badge-blue" id="profile-completion">Profile 0% complete</span>
        <p class="small muted" id="profile-missing" style="margin:6px 0 0"></p>
      </div>

      <div class="profile-layout">
        <div class="panel">
          <form id="profile-form" class="form-grid">
            <div class="field full">
              <label for="profile-name">Full name *</label>
              <input class="input" id="profile-name" name="name" autocomplete="name" required />
            </div>

            <div class="field">
              <label for="profile-category">User status</label>
              <select class="select" id="profile-user-status" name="userStatus">
                <option value="">Select your status</option>
                <option value="Student">Student</option>
                <option value="Job aspirant">Job aspirant</option>
                <option value="Teacher">Teacher</option>
                <option value="Faculty">Faculty</option>
                <option value="Research scholar">Research scholar</option>
                <option value="School">School</option>
                <option value="College">College</option>
                <option value="University">University</option>
                <option value="Coaching institute">Coaching institute</option>
                <option value="Educational organisation">Educational organisation</option>
                <option value="Government organisation">Government organisation</option>
                <option value="Private organisation">Private organisation</option>
                <option value="Open schooling provider">Open schooling provider</option>
              </select>
            </div>

            <div class="field">
              <label>Institution verification</label>
              <div id="profile-verify-status" class="small muted" style="padding-top:8px">Not verified</div>
            </div>

            <div class="field full">
              <label for="profile-portfolio">Portfolio link</label>
              <input class="input" type="url" id="profile-portfolio" name="portfolio" placeholder="https://…" />
            </div>

            <div class="field full">
              <label for="profile-resume">Resume / CV link</label>
              <input class="input" type="url" id="profile-resume" name="resumeUrl" placeholder="https://…" />
            </div>

            <div class="field full">
              <label for="profile-skills">Skills (comma separated)</label>
              <input class="input" id="profile-skills" name="skills" placeholder="Python, SQL" />
            </div>

            <div class="field full">
              <label class="check-item" style="font-weight:600">
                <input type="checkbox" id="profile-portfolio-public" name="portfolioPublic" />
                Make my portfolio public
              </label>
              <p class="small muted" style="margin:4px 0 0">
                Publishes only your name, status, state, skills, portfolio and resume link. Email, phone and date of birth
                stay private. You can turn this off any time.
              </p>
            </div>

            <div class="field full" id="portfolio-share" style="display:none">
              <label for="profile-share-link">Public portfolio link</label>
              <div style="display:flex;gap:8px;flex-wrap:wrap">
                <input class="input" id="profile-share-link" readonly style="flex:1;min-width:220px" />
                <button class="btn btn-outline btn-sm" type="button" id="profile-copy-link">Copy link</button>
                <a class="btn btn-ghost btn-sm" id="profile-view-link" href="/portfolio/" target="_blank" rel="noopener">Preview</a>
              </div>
            </div>

            <div class="field">
              <label for="profile-email">Email</label>
              <input class="input" id="profile-email" name="email" type="email" autocomplete="email" readonly />
            </div>

            <div class="field">
              <label for="profile-phone">Mobile number</label>
              <input class="input" id="profile-phone" name="phone" type="tel" autocomplete="tel" placeholder="+91XXXXXXXXXX" />
            </div>

            <div class="field">
              <label for="profile-state">State / UT</label>
              <select class="select" id="profile-state" name="stateId">
                <option value="">Select your state</option>
                {states.map((state) => (
                  <option value={state.id}>{state.name}</option>
                ))}
              </select>
            </div>

            <div class="field">
              <label for="profile-level">Current education level</label>
              <select class="select" id="profile-level" name="educationLevel">
                <option value="">Select your level</option>
                {EDUCATION_LEVELS.map((level) => (
                  <option value={level}>{level}</option>
                ))}
              </select>
            </div>

            <div class="field">
              <label for="profile-stream">Stream / subject</label>
              <select class="select" id="profile-stream" name="stream">
                <option value="">Select your stream</option>
                {streams.map((stream) => (
                  <option value={stream}>{stream}</option>
                ))}
              </select>
            </div>

            <div class="field">
              <label for="profile-dob">Date of birth</label>
              <input class="input" id="profile-dob" name="dateOfBirth" type="date" autocomplete="bday" />
            </div>

            <div class="field">
              <label for="profile-goal">Career goal</label>
              <select class="select" id="profile-goal" name="careerGoal">
                <option value="">Select a goal</option>
                {CAREER_GOALS.map((goal) => (
                  <option value={goal}>{goal}</option>
                ))}
              </select>
            </div>

            <div class="field full">
              <label>Interests</label>
              <div class="check-grid">
                {interestOptions.map((interest) => (
                  <label class="check-item">
                    <input type="checkbox" name="interests" value={interest} />
                    <span>{interest}</span>
                  </label>
                ))}
              </div>
            </div>

            <div class="field full">
              <label class="check-item" style="display:inline-flex">
                <input type="checkbox" id="profile-alerts" name="emailAlerts" />
                <span>Send me a daily email digest of updates that match my profile</span>
              </label>
            </div>

            <div class="field full" id="institution-section" style="display:none">
              <label>Institution / organisation details</label>
              <div class="form-grid" style="margin-top:8px">
                <div class="field">
                  <label for="profile-org-name">Organisation name</label>
                  <input class="input" id="profile-org-name" name="organizationName" />
                </div>
                <div class="field">
                  <label for="profile-org-website">Website</label>
                  <input class="input" id="profile-org-website" name="organizationWebsite" type="url" />
                </div>
                <div class="field full">
                  <label for="profile-org-about">About</label>
                  <textarea class="textarea" id="profile-org-about" name="organizationAbout"></textarea>
                </div>
                <div class="field full">
                  <label for="profile-proof-url">Official proof link</label>
                  <input class="input" id="profile-proof-url" name="verificationProof" type="url" placeholder="https://your-institution.edu.in/about" />
                  <p class="small muted" style="margin:6px 0 8px">
                    Link to your institution's official website or government recognition page. An admin reviews it before
                    adding a Verified badge.
                  </p>
                  <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
                    <button class="btn btn-outline btn-sm" type="button" id="profile-verify-request">Request verification</button>
                    <span class="form-message" id="profile-verify-message" role="status"></span>
                  </div>
                </div>
              </div>
            </div>

            <div class="field full" style="display:flex;gap:10px;flex-wrap:wrap;align-items:center">
              <button class="btn btn-primary" type="submit" id="profile-save">Save profile</button>
              <a class="btn btn-outline" href="/career/">View career roadmap</a>
              <span class="form-message" id="profile-message" role="status"></span>
            </div>
          </form>
        </div>

        <aside>
          <div class="sidebar-card">
            <h3>Signed in as</h3>
            <div class="account-user" style="margin-bottom:10px">
              <span class="avatar" id="profile-avatar" aria-hidden="true">FE</span>
              <div>
                <strong id="profile-display-name">Student</strong>
                <span class="badge badge-green hidden" id="profile-verified-badge">Verified</span>
                <div class="small muted" id="profile-provider">—</div>
              </div>
            </div>
            <div class="facts">
              <div><span>Email</span><strong id="profile-account-email">—</strong></div>
              <div><span>Phone</span><strong id="profile-account-phone">—</strong></div>
              <div><span>User ID</span><strong id="profile-uid" style="word-break:break-all">—</strong></div>
            </div>
            <div class="sidebar-actions" style="margin-top:12px">
              <a class="btn btn-outline" href="/account/">Saved updates</a>
              <button class="btn btn-ghost" type="button" id="profile-signout">Sign out</button>
              <button class="btn btn-danger" type="button" id="profile-delete">Delete my profile data</button>
            </div>
            <p class="small muted" style="margin:10px 0 0">
              Deleting profile data removes your education details and saved updates. You can create the profile again
              after signing in.
            </p>
          </div>

          <div class="sidebar-card">
            <h3>Why this matters</h3>
            <p class="small">
              Your class level decides which exams you can apply for. Your state decides which PSC, police, board and
              scholarship schemes appear first. Your goal decides the roadmap order.
            </p>
            <p class="small muted" style="margin:0">
              Everything is stored in your own account and is never sold or shared. Read the
              <a href="/privacy/">privacy policy</a>.
            </p>
          </div>

          <div class="sidebar-card">
            <h3>Need help?</h3>
            <p class="small muted">Write to <a href={`mailto:${SITE.email}`}>{SITE.email}</a> and we will respond within two working days.</p>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { signOutUser, watchAuth } from "../../lib/auth";
  import { CAREER_PATHS, loadProfile, saveProfile } from "../../lib/profile";
  import { getFirebaseDb } from "../../lib/firebase";
  import { addDoc, collection, deleteDoc, doc, getDocs, serverTimestamp, setDoc } from "firebase/firestore";
  import type { User } from "firebase/auth";
  import type { UserProfile } from "../../lib/types";

  const form = document.querySelector<HTMLFormElement>("#profile-form");
  const message = document.querySelector<HTMLElement>("#profile-message");
  const completionBadge = document.querySelector<HTMLElement>("#profile-completion");
  let currentUser: User | null = null;

  function show(text: string, type: "error" | "success" | "info" = "info") {
    if (!message) return;
    message.textContent = text;
    message.className = `form-message show ${type}`;
  }

  function initials(name: string) {
    return (
      name
        .split(/\s+/)
        .filter(Boolean)
        .slice(0, 2)
        .map((part) => part[0]?.toUpperCase() || "")
        .join("") || "FE"
    );
  }

  function setText(id: string, value: string) {
    const element = document.querySelector<HTMLElement>(id);
    if (element) element.textContent = value;
  }

  function completion(profile: Partial<UserProfile>) {
    const fields = [
      profile.name,
      profile.userCategory,
      profile.stateId,
      profile.educationLevel,
      profile.careerGoal,
      profile.stream,
      profile.dateOfBirth,
    ];
    const filled = fields.filter((value) => Boolean(value && String(value).trim())).length;
    return Math.round((filled / fields.length) * 100);
  }

  function missingFields(profile: Partial<UserProfile>) {
    const labels: Array<[string, unknown]> = [
      ["name", profile.name],
      ["user category", profile.userCategory],
      ["state", profile.stateId],
      ["education level", profile.educationLevel],
      ["career goal", profile.careerGoal],
      ["stream", profile.stream],
      ["date of birth", profile.dateOfBirth],
    ];
    return labels.filter(([, value]) => !value || !String(value).trim()).map(([label]) => label);
  }

  function fill(profile: UserProfile | null, user: User) {
    const name = profile?.name || user.displayName || user.email?.split("@")[0] || "";
    const nameInput = document.querySelector<HTMLInputElement>("#profile-name");
    if (nameInput) nameInput.value = name;

    const emailInput = document.querySelector<HTMLInputElement>("#profile-email");
    if (emailInput) emailInput.value = profile?.email || user.email || "";

    const phoneInput = document.querySelector<HTMLInputElement>("#profile-phone");
    if (phoneInput) phoneInput.value = profile?.phone || user.phoneNumber || "";

    const setSelect = (id: string, value?: string) => {
      const element = document.querySelector<HTMLSelectElement>(id);
      if (element) element.value = value || "";
    };
    setSelect("#profile-category", profile?.userCategory);
    setSelect("#profile-user-status", profile?.userStatus);
    setInput("#profile-portfolio", profile?.portfolio);
    setInput("#profile-resume", profile?.resumeUrl);
    setInput("#profile-skills", profile?.skills ? (profile.skills || []).join(", ") : "");

    const publicToggle = document.querySelector<HTMLInputElement>("#profile-portfolio-public");
    if (publicToggle) publicToggle.checked = Boolean(profile?.portfolioPublic);
    const share = document.querySelector<HTMLElement>("#portfolio-share");
    const shareLink = `${location.origin}/portfolio/?u=${user.uid}`;
    const shareInput = document.querySelector<HTMLInputElement>("#profile-share-link");
    if (shareInput) shareInput.value = shareLink;
    const viewLink = document.querySelector<HTMLAnchorElement>("#profile-view-link");
    if (viewLink) viewLink.href = shareLink;
    if (share) share.style.display = publicToggle?.checked ? "" : "none";
    setSelect("#profile-state", profile?.stateId);
    setSelect("#profile-level", profile?.educationLevel);
    setSelect("#profile-stream", profile?.stream);
    setSelect("#profile-goal", profile?.careerGoal);

    const dob = document.querySelector<HTMLInputElement>("#profile-dob");
    if (dob) dob.value = profile?.dateOfBirth || "";

    const interests = new Set(profile?.interests || []);
    document.querySelectorAll<HTMLInputElement>('input[name="interests"]').forEach((input) => {
      input.checked = interests.has(input.value);
    });

    const alerts = document.querySelector<HTMLInputElement>("#profile-alerts");
    if (alerts) alerts.checked = profile?.emailAlerts !== false;

    const orgName = document.querySelector<HTMLInputElement>("#profile-org-name");
    if (orgName) orgName.value = profile?.organizationName || "";
    const orgWebsite = document.querySelector<HTMLInputElement>("#profile-org-website");
    if (orgWebsite) orgWebsite.value = profile?.organizationWebsite || "";
    const orgAbout = document.querySelector<HTMLTextAreaElement>("#profile-org-about");
    if (orgAbout) orgAbout.value = profile?.organizationAbout || "";

    const institutionCategories = new Set(["Educational institution","Coaching institute","School","College","University","Government organisation","Private organisation","Open schooling service provider"]);
    const section = document.querySelector<HTMLElement>("#institution-section");
    if (section) section.style.display = institutionCategories.has(profile?.userCategory || "") ? "" : "none";

    setText("#profile-avatar", initials(name));
    setText("#profile-display-name", name || "Student");

    const verified = Boolean(profile?.institutionVerified);
    document.querySelector<HTMLElement>("#profile-verified-badge")?.classList.toggle("hidden", !verified);
    const verifyStatus = document.querySelector<HTMLElement>("#profile-verify-status");
    if (verifyStatus) {
      if (verified) {
        verifyStatus.innerHTML = '<span class="badge badge-green">Verified</span> Institution details verified by FollowExam.';
      } else if (profile?.verificationStatus === "pending") {
        verifyStatus.innerHTML = '<span class="badge badge-amber">Pending review</span> Your proof link is with the admin team.';
      } else {
        verifyStatus.innerHTML = '<span class="badge badge-amber">Not verified</span> Submit an official proof link to request a badge.';
      }
    }
    setText("#profile-account-email", user.email || profile?.email || "—");
    setText("#profile-account-phone", user.phoneNumber || profile?.phone || "—");
    setText("#profile-uid", user.uid);
    setText(
      "#profile-provider",
      user.providerData.map((provider) => provider.providerId.replace(".com", "")).join(", ") || "Email",
    );

    const percent = completion(profile || {});
    if (completionBadge) {
      completionBadge.textContent = `Profile ${percent}% complete`;
      completionBadge.className = `badge ${percent >= 80 ? "badge-green" : percent >= 40 ? "badge-amber" : "badge-blue"}`;
    }
    const missingEl = document.querySelector<HTMLElement>("#profile-missing");
    if (missingEl) {
      const missing = missingFields(profile || {});
      missingEl.textContent = missing.length
        ? `Still needed: ${missing.join(", ")}.`
        : "All core fields complete.";
    }
  }

  const institutionCategories = new Set(["Educational institution","Coaching institute","School","College","University","Government organisation","Private organisation","Open schooling service provider"]);
  const categorySelect = document.querySelector<HTMLSelectElement>("#profile-category");
  categorySelect?.addEventListener("change", () => {
    const section = document.querySelector<HTMLElement>("#institution-section");
    if (section) section.style.display = institutionCategories.has(categorySelect.value) ? "" : "none";
  });

  document.querySelector("#profile-verify-request")?.addEventListener("click", async () => {
    if (!currentUser) {
      show("Sign in first to request verification.", "error");
      return;
    }
    const proof = document.querySelector<HTMLInputElement>("#profile-proof-url")?.value.trim() || "";
    const orgName = document.querySelector<HTMLInputElement>("#profile-org-name")?.value.trim() || "";
    const orgWebsite = document.querySelector<HTMLInputElement>("#profile-org-website")?.value.trim() || "";
    const orgAbout = document.querySelector<HTMLTextAreaElement>("#profile-org-about")?.value.trim() || "";
    const name =
      document.querySelector<HTMLInputElement>("#profile-name")?.value.trim() || currentUser.displayName || "FollowExam member";
    const email =
      currentUser.email || document.querySelector<HTMLInputElement>("#profile-email")?.value.trim() || "";
    const note = document.querySelector<HTMLElement>("#profile-verify-message");

    const setNote = (text: string, type: "error" | "success" | "info" = "info") => {
      if (!note) return;
      note.textContent = text;
      note.className = `form-message show ${type}`;
    };

    if (!/^https?:\/\//i.test(proof)) {
      setNote("Add a full official proof link starting with https://.", "error");
      return;
    }
    if (!orgName) {
      setNote("Add your organisation name first.", "error");
      return;
    }
    const db = getFirebaseDb();
    if (!db) {
      setNote("Verification requests are temporarily unavailable.", "error");
      return;
    }

    setNote("Sending verification request…", "info");
    try {
      await addDoc(collection(db, "inquiries"), {
        institutionId: `verification-${currentUser.uid}`,
        institutionName: orgName,
        uid: currentUser.uid,
        name,
        email,
        phone: "",
        topic: "Institution verification",
        kind: "institution-verification",
        proofUrl: proof,
        website: orgWebsite,
        about: orgAbout,
        message: `Institution verification request for ${orgName}. Official proof: ${proof}${orgWebsite ? `\nWebsite: ${orgWebsite}` : ""}${orgAbout ? `\nAbout: ${orgAbout}` : ""}`,
        consent: true,
        status: "new",
        source: "profile-verification",
        createdAt: new Date().toISOString(),
        serverCreatedAt: serverTimestamp(),
      });
      await setDoc(
        doc(db, "users", currentUser.uid),
        {
          verificationStatus: "pending",
          verificationProof: proof,
          verificationRequestedAt: new Date().toISOString(),
        },
        { merge: true },
      );
      setNote("Request sent. An admin will review your proof link and add the Verified badge.", "success");
    } catch (error) {
      setNote(error instanceof Error ? error.message : "Could not send the request. Please try again.", "error");
    }
  });

  watchAuth(async (user) => {
    currentUser = user;
    if (!user) {
      fill(null, { uid: "", providerData: [] } as unknown as User);
      return;
    }
    const profile = await loadProfile(user);
    fill(profile, user);
    if (profile?.careerGoal && CAREER_PATHS[profile.careerGoal]) {
      show(`Roadmap ready for ${profile.careerGoal}.`, "info");
    }
  });

  document.querySelector("#profile-portfolio-public")?.addEventListener("change", (event) => {
    const share = document.querySelector<HTMLElement>("#portfolio-share");
    if (share) share.style.display = (event.target as HTMLInputElement).checked ? "" : "none";
  });

  document.querySelector("#profile-copy-link")?.addEventListener("click", async () => {
    const input = document.querySelector<HTMLInputElement>("#profile-share-link");
    if (!input?.value) return;
    try {
      await navigator.clipboard.writeText(input.value);
      show("Portfolio link copied.", "success");
    } catch {
      input.select();
      show("Select and copy the link manually.", "info");
    }
  });

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!currentUser) {
      show("Sign in first to save your profile.", "error");
      return;
    }

    const data = new FormData(form);
    const stateId = String(data.get("stateId") || "");
    const stateName =
      document.querySelector<HTMLSelectElement>("#profile-state")?.selectedOptions[0]?.textContent || "";
    const interests = [...form.querySelectorAll<HTMLInputElement>('input[name="interests"]:checked')].map(
      (input) => input.value,
    );

    const button = document.querySelector<HTMLButtonElement>("#profile-save");
    if (button) button.disabled = true;
    show("Saving…", "info");

    try {
      const publicProfile = Boolean(data.get("portfolioPublic"));
      const skills = String(data.get("skills") || "").split(",").map(s => s.trim()).filter(Boolean);
      await saveProfile(currentUser, {
        name: String(data.get("name") || "").trim(),
        userCategory: String(data.get("userCategory") || "") as UserProfile["userCategory"],
        userStatus: String(data.get("userStatus") || "") as UserProfile["userStatus"],
        portfolio: String(data.get("portfolio") || "") || undefined,
        resumeUrl: String(data.get("resumeUrl") || "") || undefined,
        portfolioPublic: publicProfile,
        skills: skills.length ? skills : undefined,
        email: String(data.get("email") || "").trim(),
        phone: String(data.get("phone") || "").trim(),
        stateId,
        stateName: stateId ? stateName : "",
        educationLevel: String(data.get("educationLevel") || "") as UserProfile["educationLevel"],
        stream: String(data.get("stream") || ""),
        dateOfBirth: String(data.get("dateOfBirth") || ""),
        careerGoal: String(data.get("careerGoal") || "") as UserProfile["careerGoal"],
        organizationName: String(data.get("organizationName") || "").trim(),
        organizationWebsite: String(data.get("organizationWebsite") || "").trim(),
        organizationAbout: String(data.get("organizationAbout") || "").trim(),
        interests,
        emailAlerts: Boolean(data.get("emailAlerts")),
      });

      // Public portfolio is a separate, opt-in document so private fields never leak.
      const db = getFirebaseDb();
      if (db) {
        try {
          if (publicProfile) {
            await setDoc(
              doc(db, "portfolios", currentUser.uid),
              {
                uid: currentUser.uid,
                name: String(data.get("name") || "").trim() || currentUser.displayName || "FollowExam member",
                headline: String(data.get("careerGoal") || "") || String(data.get("userStatus") || ""),
                userStatus: String(data.get("userStatus") || ""),
                stateName: stateId ? stateName : "",
                educationLevel: String(data.get("educationLevel") || ""),
                skills,
                portfolio: String(data.get("portfolio") || ""),
                resumeUrl: String(data.get("resumeUrl") || ""),
                organizationName: String(data.get("organizationName") || "").trim(),
                updatedAt: new Date().toISOString(),
                serverUpdatedAt: serverTimestamp(),
              },
              { merge: true },
            );
          } else {
            await deleteDoc(doc(db, "portfolios", currentUser.uid));
          }
        } catch {
          show("Profile saved, but the public portfolio could not update. Try again.", "error");
          return;
        }
      }

      const refreshed = await loadProfile(currentUser);
      fill(refreshed, currentUser);
      show("Profile saved. Recommendations update immediately.", "success");
    } catch (error) {
      show(error instanceof Error ? error.message : "Could not save the profile.", "error");
    } finally {
      if (button) button.disabled = false;
    }
  });

  document.querySelector("#profile-signout")?.addEventListener("click", async () => {
    await signOutUser();
    window.location.href = "/login/";
  });

  document.querySelector("#profile-delete")?.addEventListener("click", async () => {
    if (!currentUser) return;
    if (!confirm("Delete your profile details and saved updates? This cannot be undone.")) return;
    const db = getFirebaseDb();
    if (!db) {
      show("Could not connect to the database.", "error");
      return;
    }
    try {
      const saved = await getDocs(collection(db, "users", currentUser.uid, "saved"));
      await Promise.all(saved.docs.map((item) => deleteDoc(item.ref)));
      await deleteDoc(doc(db, "users", currentUser.uid));
      await deleteDoc(doc(db, "portfolios", currentUser.uid)).catch(() => {});
      form?.reset();
      show("Profile data deleted. You can create it again from this page.", "success");
    } catch (error) {
      show(error instanceof Error ? error.message : "Could not delete the profile data.", "error");
    }
  });
</script>
