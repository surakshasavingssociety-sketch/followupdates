---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { scholarshipDatabase } from "../../lib/scholarships";
import { states } from "../../lib/states";
---

<BaseLayout title="Scholarship eligibility checker" description="Check which scholarships you may be eligible for.">
  <section class="section">
    <div class="container">
      <div class="eyebrow" style="background:var(--brand-soft);color:var(--brand);border-color:transparent">Scholarship tools</div>
      <h1>Scholarship eligibility checker</h1>
      <p class="muted">Enter your details to see which scholarships you may qualify for.</p>

      <div class="form-card" style="margin-top:16px">
        <form id="elig-form" class="form-grid">
          <div class="field">
            <label for="elig-state">State</label>
            <select class="select" id="elig-state" name="state">
              <option value="">Select state</option>
              {states.map((s) => <option value={s.id}>{s.name}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="elig-level">Education level</label>
            <select class="select" id="elig-level" name="level">
              <option value="">Select level</option>
              <option value="Class 10">Class 10</option>
              <option value="Class 12">Class 12</option>
              <option value="Graduate">Graduate</option>
              <option value="Postgraduate">Postgraduate</option>
            </select>
          </div>
          <div class="field">
            <label for="elig-category">Category</label>
            <select class="select" id="elig-category" name="category">
              <option value="">General</option>
              <option value="SC">SC</option>
              <option value="ST">ST</option>
              <option value="OBC">OBC</option>
              <option value="EWS">EWS</option>
              <option value="Minority">Minority</option>
            </select>
          </div>
          <div class="field full">
            <button class="btn btn-primary" type="submit">Check eligibility</button>
          </div>
        </form>
      </div>

      <div id="elig-results" class="mt-3"></div>
    </div>
  </section>
</BaseLayout>

<script>
  import { scholarshipDatabase } from "../../lib/scholarships";
  const form = document.querySelector("#elig-form");
  const results = document.querySelector("#elig-results");
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const data = new FormData(form as HTMLFormElement);
    const state = String(data.get("state") || "");
    const level = String(data.get("level") || "");
    const category = String(data.get("category") || "");
    const list = scholarshipDatabase.scholarships.filter((s) => {
      const inState = s.scope === "central" || s.stateId === state;
      const levelMatch = !level || s.level.includes(level) || s.level.includes("All levels");
      const catMatch = !category || s.categories.includes(category) || s.categories.includes("All");
      return inState && levelMatch && catMatch;
    });
    if (results) {
      results.innerHTML = list.length
        ? `<h2>${list.length} matching scholarships</h2>` +
          list.map((s) => `<div class="panel" style="margin-bottom:8px"><h3>${s.name}</h3><p class="small muted">${s.provider} · ${s.amount}</p><a class="link-arrow" href="/scholarships/${s.slug}/">View →</a></div>`).join("")
        : `<p class="muted">No matching scholarships found. Try broader filters.</p>`;
    }
  });
</script>
