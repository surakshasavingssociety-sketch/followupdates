---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StateCard from "../../components/StateCard.astro";
import { SITE } from "../../lib/constants";
import { examDatabase } from "../../lib/exams";
import { states, statesByRegion, unionTerritories } from "../../lib/states";

const groups = statesByRegion();

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "State-wise government exams and jobs",
    description: "State PSC, police, TET and board exam coverage for all Indian states and union territories.",
    url: `${SITE.url}/states/`,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE.url}/` },
      { "@type": "ListItem", position: 2, name: "States", item: `${SITE.url}/states/` },
    ],
  },
];
---

<BaseLayout
  title="State-wise Government Jobs & Exams — All States and UTs"
  description="Browse state PSC, police constable, SI, TET and board exam cycles for all 28 states and 8 union territories of India, with official portal links."
  schema={schema}
>
  <section class="section-tight" style="padding-top:30px">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span><span>States</span>
      </nav>

      <div class="section-head" style="margin-bottom:14px">
        <div>
          <h1 style="font-size:clamp(1.8rem,3.6vw,2.5rem)">State-wise coverage</h1>
          <p>
            {states.length} states/UTs · {states.length - unionTerritories.length} states · {unionTerritories.length} union territories.
            Apne state ka PSC, police, TET aur board exam cycle dekhein.
          </p>
        </div>
        <a class="btn btn-outline btn-sm" href="/exams/">🏛 Central exams</a>
      </div>

      <div class="notice-bar" style="margin-bottom:22px">
        <div class="container" style="padding:0">
          <strong>Note:</strong> State exam dates aur vacancy patterns badalte rehte hain. Har state ka official portal aur
          conducting body link neeche diya gaya hai — apply se pehle wahan verify karein.
        </div>
      </div>

      {groups.map((group) => (
        <section style="margin-bottom:34px">
          <div class="section-head" style="margin-bottom:14px">
            <div>
              <h2 style="font-size:clamp(1.3rem,2.4vw,1.7rem)">{group.region}</h2>
              <p>{group.states.length} states/UTs in this region.</p>
            </div>
            <span class="badge badge-muted">{group.states.length}</span>
          </div>
          <div class="grid-3">
            {group.states.map((state) => <StateCard state={state} />)}
          </div>
        </section>
      ))}

      <section class="panel" style="margin-top:10px">
        <div class="section-head" style="margin-bottom:10px">
          <div>
            <h2 style="font-size:1.35rem">Exam database</h2>
            <p>{examDatabase.counts.total} exams ke notification, exam aur result windows.</p>
          </div>
          <a class="btn btn-primary btn-sm" href="/calendar/">Open exam calendar</a>
        </div>
        <p class="muted" style="margin:0">
          Central exams ke liye <a href="/exams/">exam database</a> dekhein. State exams ke liye upar apna state chuniye.
        </p>
      </section>
    </div>
  </section>
</BaseLayout>
