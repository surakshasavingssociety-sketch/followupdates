---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdminNav from "../../components/AdminNav.astro";
import { SITE } from "../../lib/constants";
import fs from "node:fs";
import path from "node:path";

const sourcesFile = path.join(process.cwd(), "data", "sources.json");
const sources = JSON.parse(fs.readFileSync(sourcesFile, "utf8"));

let report: any = {};
try {
  report = JSON.parse(fs.readFileSync(path.join(process.cwd(), "data", "ingest-report.json"), "utf8"));
} catch {
  report = {};
}
const errorsBySource = new Map<string, string>(
  (report.errors || []).map((entry: any) => [String(entry.source || ""), String(entry.error || "Unknown error")]),
);
const sourceError = (name: string) => {
  for (const [label, error] of errorsBySource) {
    if (label.includes(name)) return error;
  }
  return "";
};

const rows = [
  ...(sources.googleNews || []).map((s) => ({ name: s.name, type: "Google News", category: s.category, maxItems: s.maxItems, enabled: s.enabled !== false })),
  ...(sources.rss || []).map((s) => ({ name: s.name, type: "RSS", category: s.category, maxItems: s.maxItems, enabled: s.enabled !== false })),
  ...(sources.html || []).map((s) => ({ name: s.name, type: "HTML scrape", category: s.category, maxItems: s.maxItems, enabled: s.enabled !== false })),
].map((row) => {
  const error = sourceError(row.name);
  return {
    ...row,
    error,
    status: !row.enabled ? "Disabled" : error ? "Failed" : "Configured",
  };
});

const runAt = report.runAt ? new Date(report.runAt) : null;
const lastRun = runAt && !Number.isNaN(runAt.getTime()) ? runAt.toLocaleString("en-IN") : "No run recorded";
---

<BaseLayout banner={false} title="Automation control" description="Monitor and manage government source monitoring (admin only)." noindex>
  <section class="section-tight" style="padding-top:30px">
    <div class="container">
      <AdminNav />
      <div class="breadcrumb" style="padding:0 0 14px">
        <a href="/">Dashboard</a><span>/</span>
        <a href="/admin/">Admin</a><span>/</span><span>Automation</span>
      </div>

      <div class="section-head" style="margin-bottom:18px">
        <div>
          <div class="eyebrow">Admin</div>
          <h1 style="font-size:clamp(1.8rem,3.6vw,2.5rem)">Automation control center</h1>
          <p>Monitor government sources, review discovery status and manage the notification pipeline. Automation runs via GitHub Actions (daily.yml).</p>
        </div>
      </div>

      <div id="auto-loading" class="panel">
        <p class="muted small">Checking admin access…</p>
      </div>

      <div id="auto-config" class="panel hidden">
        <p class="small muted">Firebase is not configured. Set PUBLIC_FIREBASE_* values and rebuild.</p>
      </div>

      <div id="auto-login" class="form-card hidden">
        <h2>Admin sign in</h2>
        <p class="muted small">Only authorised administrators can trigger automation.</p>
        <form id="auto-login-form" class="form-grid">
          <div class="field"><label for="auto-email">Email</label><input class="input" id="auto-email" type="email" autocomplete="email" required /></div>
          <div class="field"><label for="auto-password">Password</label><input class="input" id="auto-password" type="password" autocomplete="current-password" required /></div>
          <div class="field full"><button class="btn btn-primary" type="submit">Sign in</button></div>
          <p class="form-message" id="auto-login-message" role="status"></p>
        </form>
      </div>

      <div id="auto-denied" class="form-card hidden">
        <h2>Access denied</h2>
        <p class="muted small">This account is not an admin.</p>
        <button class="btn btn-outline" type="button" id="auto-denied-signout">Sign out</button>
      </div>

      <div id="auto-panel" class="hidden">
        <div class="panel dash-banner" style="margin-bottom:18px">
          <div style="display:flex;gap:16px;flex-wrap:wrap;align-items:center;justify-content:space-between">
            <div>
              <div class="eyebrow" style="background:var(--brand-soft);color:var(--brand);border-color:transparent">Automation trigger</div>
              <h2 style="margin:8px 0 4px;font-size:1.3rem">Run the pipeline now</h2>
              <p class="small muted" style="margin:0;max-width:620px">
                Queues a run for the GitHub Actions worker. It polls every 10 minutes and runs
                <code>npm run ingest &amp;&amp; npm run sync</code>. No deploy is triggered; review new items in the queue.
              </p>
            </div>
            <button class="btn btn-primary" type="button" id="auto-run">Run automation now</button>
          </div>
        </div>

        <div class="form-message" id="auto-message" role="status"></div>

        <div class="panel" style="margin-bottom:18px">
          <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;justify-content:space-between">
            <div>
              <h3 style="margin:0 0 4px">Recent admin-triggered runs</h3>
              <p class="small muted" style="margin:0">Latest requests from this panel. The worker updates each status automatically.</p>
            </div>
            <button class="btn btn-outline btn-sm" type="button" id="auto-refresh">Refresh</button>
          </div>
          <div id="auto-runs" class="admin-list" style="margin-top:12px">
            <p class="small muted">Loading runs…</p>
          </div>
        </div>

        <div class="panel">
          <h3 style="margin:0 0 8px">Manual command</h3>
          <p class="small muted" style="margin:0 0 8px">Run locally or from the GitHub Actions tab if the worker is paused:</p>
          <pre style="margin:0;padding:12px;background:var(--surface-2);border-radius:9px;overflow-x:auto"><code>npm run ingest &amp;&amp; npm run sync</code></pre>
          <p class="small muted" style="margin:10px 0 0">
            The worker needs the <code>FIREBASE_SERVICE_ACCOUNT</code> repository secret. GitHub → Actions →
            <strong>Admin-triggered automation</strong> → Run workflow also works.
          </p>
        </div>
      </div>

      <div class="panel" style="margin-bottom:18px">
        <h3 style="margin:0 0 8px">Pipeline</h3>
        <p class="small muted" style="margin:0">
          Official Government Website → Source Monitoring → New Notification Detection → Content Extraction → Duplicate Check →
          Category Identification → Draft Generation → Admin Verification → Approval → Publishing.
        </p>
        <p class="small" style="margin:8px 0 0">
          Runs daily at 02:00 UTC via GitHub Actions. Manual trigger: GitHub → Actions → Daily update pipeline → Run workflow.
        </p>
      </div>

      <div class="panel" style="margin-bottom:18px">
        <h3 style="margin:0 0 8px">Latest run</h3>
        <div class="facts" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:10px">
          <div><span class="small muted">Last run</span><strong>{lastRun}</strong></div>
          <div><span class="small muted">New items</span><strong>{report.newItems ?? "—"}</strong></div>
          <div><span class="small muted">Pending total</span><strong>{report.totalPending ?? "—"}</strong></div>
          <div><span class="small muted">Failures</span><strong>{(report.errors || []).length}</strong></div>
        </div>
        {(report.errors || []).length ? (
          <ul class="small" style="margin:10px 0 0;padding-left:18px">
            {report.errors.map((entry: any) => (
              <li><strong>{entry.source}</strong>: {entry.error}</li>
            ))}
          </ul>
        ) : (
          <p class="small muted" style="margin:8px 0 0">No source failures in the latest recorded run.</p>
        )}
      </div>

      <div class="panel" style="margin-bottom:18px">
        <h3 style="margin:0 0 8px">Government source registry</h3>
        <p class="small muted" style="margin:0 0 10px">
          {rows.length} configured source(s), {rows.filter((row) => !row.enabled).length} disabled. Add, disable or edit
          sources in <code>data/sources.json</code> (<code>"enabled": false</code> skips a source on the next run).
        </p>
        <div style="overflow-x:auto">
          <table style="width:100%;border-collapse:collapse;font-size:0.9rem">
            <thead>
              <tr style="text-align:left;border-bottom:1px solid var(--line)">
                <th style="padding:8px">Source</th>
                <th style="padding:8px">Type</th>
                <th style="padding:8px">Category</th>
                <th style="padding:8px">Max items</th>
                <th style="padding:8px">Status</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((row) => (
                <tr style="border-bottom:1px solid var(--line)">
                  <td style="padding:8px">{row.name}</td>
                  <td style="padding:8px">{row.type}</td>
                  <td style="padding:8px">{row.category}</td>
                  <td style="padding:8px">{row.maxItems}</td>
                  <td style="padding:8px"><span class={`badge ${row.status === "Configured" ? "badge-green" : row.status === "Disabled" ? "badge-muted" : "badge-red"}`} title={row.error || ""}>{row.status}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div class="panel">
        <h3 style="margin:0 0 6px">Notification tracking</h3>
        <p class="small muted" style="margin:0">
          Expected vs. actual notification dates are tracked per organisation and exam. Expected dates are estimates only,
          never presented as official dates. See <code>data/pending.json</code> and the admin review queue for current
          discoveries.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { onAuthStateChanged, signInWithEmailAndPassword, signOut, type User } from "firebase/auth";
  import {
    addDoc,
    collection,
    doc,
    getDoc,
    getDocs,
    limit,
    orderBy,
    query,
    serverTimestamp,
  } from "firebase/firestore";
  import { firebaseConfigured, getFirebaseAuth, getFirebaseDb } from "../../lib/firebase";

  const loadingPanel = document.querySelector<HTMLElement>("#auto-loading");
  const configPanel = document.querySelector<HTMLElement>("#auto-config");
  const loginPanel = document.querySelector<HTMLElement>("#auto-login");
  const deniedPanel = document.querySelector<HTMLElement>("#auto-denied");
  const panel = document.querySelector<HTMLElement>("#auto-panel");
  const runsList = document.querySelector<HTMLElement>("#auto-runs");
  const message = document.querySelector<HTMLElement>("#auto-message");
  const runButton = document.querySelector<HTMLButtonElement>("#auto-run");

  const auth = firebaseConfigured ? getFirebaseAuth() : null;
  const db = firebaseConfigured ? getFirebaseDb() : null;
  let currentUser: User | null = null;

  function show(target: HTMLElement | null) {
    [loadingPanel, configPanel, loginPanel, deniedPanel, panel].forEach((item) => item?.classList.add("hidden"));
    target?.classList.remove("hidden");
  }

  function showMessage(text: string, type: "error" | "success" | "info" = "info") {
    if (!message) return;
    message.textContent = text;
    message.className = `form-message show ${type}`;
    if (type === "success") setTimeout(() => message.classList.remove("show"), 5000);
  }

  function esc(value: unknown) {
    return String(value ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  function statusBadge(status: string) {
    if (status === "completed") return "badge-green";
    if (status === "running") return "badge-blue";
    if (status === "failed") return "badge-red";
    return "badge-amber";
  }

  function renderRuns(runs: Record<string, any>[]) {
    if (!runsList) return;
    if (!runs.length) {
      runsList.innerHTML = `<div class="empty"><h3>No admin-triggered runs yet</h3><p>Press “Run automation now” to queue the first one.</p></div>`;
      return;
    }
    runsList.innerHTML = runs
      .map((run) => {
        const status = String(run.status || "queued");
        const when = run.createdAt ? new Date(run.createdAt).toLocaleString("en-IN") : "—";
        const finished = run.finishedAt ? ` · finished ${new Date(run.finishedAt).toLocaleString("en-IN")}` : "";
        return `
        <article class="admin-item">
          <div class="admin-item-head">
            <div>
              <h3 style="margin:0 0 4px">Run ${esc(String(run.id || "").slice(0, 8))}</h3>
              <div class="admin-item-meta">${esc(run.requestedBy || "admin")} · queued ${esc(when)}${esc(finished)}</div>
            </div>
            <span class="badge ${statusBadge(status)}">${esc(status)}</span>
          </div>
          ${run.message ? `<p class="small muted" style="margin:8px 0 0">${esc(run.message)}</p>` : ""}
        </article>`;
      })
      .join("");
  }

  async function loadRuns() {
    if (!db || !runsList) return;
    try {
      const snapshot = await getDocs(query(collection(db, "automationRuns"), orderBy("createdAt", "desc"), limit(10)));
      renderRuns(snapshot.docs.map((item) => ({ id: item.id, ...item.data() })));
    } catch {
      try {
        const snapshot = await getDocs(collection(db, "automationRuns"));
        renderRuns(
          snapshot.docs
            .map((item) => ({ id: item.id, ...item.data() }))
            .sort((a: any, b: any) => String(b.createdAt || "").localeCompare(String(a.createdAt || "")))
            .slice(0, 10),
        );
      } catch (error) {
        runsList.innerHTML = `<div class="empty"><h3>Could not load runs</h3><p>${esc(error instanceof Error ? error.message : "Unknown error")}</p></div>`;
      }
    }
  }

  if (!auth || !db) {
    show(configPanel);
  } else {
    onAuthStateChanged(auth, async (user) => {
      currentUser = user;
      if (!user) {
        show(loginPanel);
        return;
      }
      try {
        const adminDoc = await getDoc(doc(db, "admins", user.uid));
        if (!adminDoc.exists()) {
          show(deniedPanel);
          return;
        }
        show(panel);
        await loadRuns();
      } catch (error) {
        console.error(error);
        show(deniedPanel);
      }
    });

    document.querySelector("#auto-login-form")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const email = document.querySelector<HTMLInputElement>("#auto-email")?.value.trim() || "";
      const password = document.querySelector<HTMLInputElement>("#auto-password")?.value || "";
      const loginMessage = document.querySelector<HTMLElement>("#auto-login-message");
      try {
        await signInWithEmailAndPassword(auth, email, password);
      } catch (error) {
        if (loginMessage) {
          loginMessage.textContent = error instanceof Error ? error.message : "Sign-in failed.";
          loginMessage.className = "form-message show error";
        }
      }
    });

    runButton?.addEventListener("click", async () => {
      if (!currentUser || !db) return;
      runButton.disabled = true;
      runButton.textContent = "Queueing…";
      try {
        await addDoc(collection(db, "automationRuns"), {
          status: "queued",
          source: "admin-panel",
          requestedBy: currentUser.email || currentUser.uid,
          requestedByUid: currentUser.uid,
          createdAt: new Date().toISOString(),
          serverCreatedAt: serverTimestamp(),
        });
        showMessage(
          "Automation queued. The GitHub Actions worker picks it up within about 10 minutes; refresh to see the status.",
          "success",
        );
        await loadRuns();
      } catch (error) {
        showMessage(error instanceof Error ? error.message : "Could not queue automation.", "error");
      } finally {
        runButton.disabled = false;
        runButton.textContent = "Run automation now";
      }
    });

    document.querySelector("#auto-refresh")?.addEventListener("click", () => loadRuns());
    document.querySelector("#auto-denied-signout")?.addEventListener("click", () => signOut(auth));
  }
</script>
