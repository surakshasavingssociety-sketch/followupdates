---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdminNav from "../../components/AdminNav.astro";
import { SITE } from "../../lib/constants";
import fs from "node:fs";
import path from "node:path";

const trackingFile = path.join(process.cwd(), "data", "notification-tracking.json");
const tracking = JSON.parse(fs.readFileSync(trackingFile, "utf8"));
const records = tracking.records || [];
---

<BaseLayout title="Notification tracking" description="Track expected vs actual government notifications (admin only)." noindex>
  <section class="section-tight" style="padding-top:30px">
    <div class="container">
      <AdminNav />
      <div class="breadcrumb" style="padding:0 0 14px">
        <a href="/">Dashboard</a><span>/</span>
        <a href="/admin/">Admin</a><span>/</span><span>Notification tracking</span>
      </div>

      <div class="section-head" style="margin-bottom:18px">
        <div>
          <div class="eyebrow">Admin</div>
          <h1 style="font-size:clamp(1.8rem,3.6vw,2.5rem)">Notification tracking</h1>
          <p>Expected vs. actual notification dates per organisation and exam. Expected dates are estimates only.</p>
        </div>
      </div>

      <div class="panel" style="margin-bottom:18px">
        <p class="small muted" style="margin:0">{records.length} tracked record(s). Edit <code>data/notification-tracking.json</code> or the Firestore <code>notificationTracking</code> collection.</p>
      </div>

      <div style="overflow-x:auto">
        <table style="width:100%;border-collapse:collapse;font-size:0.85rem">
          <thead>
            <tr style="text-align:left;border-bottom:1px solid var(--line)">
              <th style="padding:8px">Organisation</th>
              <th style="padding:8px">Expected type</th>
              <th style="padding:8px">Expected period</th>
              <th style="padding:8px">Previous date</th>
              <th style="padding:8px">Actual date</th>
              <th style="padding:8px">Status</th>
            </tr>
          </thead>
          <tbody>
            {records.map((r) => (
              <tr style="border-bottom:1px solid var(--line)">
                <td style="padding:8px">{r.organization}</td>
                <td style="padding:8px">{r.expectedType}</td>
                <td style="padding:8px">{r.expectedPeriod}</td>
                <td style="padding:8px">{r.previousNotificationDate || "—"}</td>
                <td style="padding:8px">{r.actualNotificationDate || "—"}</td>
                <td style="padding:8px"><span class={`badge ${r.monitoringStatus === "completed" ? "badge-green" : "badge-amber"}`}>{r.monitoringStatus}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</BaseLayout>
