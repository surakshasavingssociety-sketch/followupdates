---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Admin users" description="Manage admin roles and permissions." noindex>
  <section class="section-tight" style="padding-top:30px">
    <div class="container">
      <div class="breadcrumb" style="padding:0 0 14px">
        <a href="/">Dashboard</a><span>/</span>
        <a href="/admin/">Admin</a><span>/</span><span>Admin users</span>
      </div>

      <div class="section-head" style="margin-bottom:18px">
        <div>
          <div class="eyebrow">Admin</div>
          <h1 style="font-size:clamp(1.8rem,3.6vw,2.5rem)">Admin users &amp; roles</h1>
          <p>Super Admins manage roles. Admins can review and publish. Moderators can review the queue. Every role change is written to the activity log.</p>
        </div>
      </div>

      <div id="au-config" class="panel hidden">
        <p class="small muted">Firebase is not configured. Set PUBLIC_FIREBASE_* values and rebuild.</p>
      </div>

      <div id="au-login" class="form-card hidden">
        <h2>Sign in</h2>
        <p class="muted small">Admin access only.</p>
        <form id="au-login-form" class="form-grid">
          <div class="field"><label for="au-email">Email</label><input class="input" id="au-email" type="email" required /></div>
          <div class="field"><label for="au-password">Password</label><input class="input" id="au-password" type="password" required /></div>
          <div class="field full"><button class="btn btn-primary" type="submit">Sign in</button></div>
          <p class="form-message" id="au-login-message" role="status"></p>
        </form>
      </div>

      <div id="au-denied" class="form-card hidden">
        <h2>Access denied</h2>
        <p class="muted small">This account is not an admin.</p>
        <button class="btn btn-outline" type="button" id="au-denied-signout">Sign out</button>
      </div>

      <div id="au-panel" class="hidden">
        <div class="form-message" id="au-message" role="status"></div>

        <div class="panel" id="au-readonly" style="margin-bottom:16px;display:none">
          <p class="small muted" style="margin:0">Read-only view. Only a Super Admin can add admins or change roles.</p>
        </div>

        <div id="au-list" class="admin-list"></div>

        <div class="panel" id="au-add-panel" style="margin-top:18px;display:none">
          <h2 style="font-size:1.2rem;margin:0 0 4px">Add an admin</h2>
          <p class="small muted" style="margin:0 0 12px">
            Ask the person to sign in once, then copy their user ID from Firebase Authentication. Add the matching
            <code>admins/&#123;uid&#125;</code> document here.
          </p>
          <form id="au-add-form" class="form-grid">
            <div class="field"><label for="au-new-uid">Firebase user ID *</label><input class="input" id="au-new-uid" required /></div>
            <div class="field"><label for="au-new-email">Email</label><input class="input" id="au-new-email" type="email" /></div>
            <div class="field">
              <label for="au-new-role">Role</label>
              <select class="select" id="au-new-role">
                <option value="admin">Admin</option>
                <option value="manager">Manager</option>
                <option value="executive">Executive</option>
                <option value="moderator">Moderator</option>
                <option value="super_admin">Super Admin</option>
              </select>
            </div>
            <div class="field full"><button class="btn btn-primary" type="submit">Add admin</button></div>
          </form>
        </div>

        <div class="panel" style="margin-top:18px">
          <h3 style="margin:0 0 6px">Role permissions</h3>
          <ul class="small" style="margin:0;padding-left:18px">
            <li><strong>Super Admin</strong> — everything, including deleting jobs, managing admins and roles.</li>
            <li><strong>Admin</strong> — review and publish notifications, manage CMS fields, view subscribers.</li>
            <li><strong>Manager</strong> — manage content queues, institutions and payment settings; cannot change admin roles.</li>
            <li><strong>Executive</strong> — review pending notifications and update details; no admin or billing access.</li>
            <li><strong>Moderator</strong> — review the pending queue and edit fields; cannot manage admins.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <script>
    import { onAuthStateChanged, signInWithEmailAndPassword, signOut } from "firebase/auth";
    import { addDoc, collection, doc, getDoc, getDocs, serverTimestamp, setDoc, updateDoc } from "firebase/firestore";
    import { getFirebaseAuth, getFirebaseDb } from "../../lib/firebase";

    const auth = getFirebaseAuth();
    const db = getFirebaseDb();

    const configPanel = document.querySelector<HTMLElement>("#au-config");
    const loginPanel = document.querySelector<HTMLElement>("#au-login");
    const deniedPanel = document.querySelector<HTMLElement>("#au-denied");
    const adminPanel = document.querySelector<HTMLElement>("#au-panel");
    const list = document.querySelector<HTMLElement>("#au-list");
    const message = document.querySelector<HTMLElement>("#au-message");
    const readonly = document.querySelector<HTMLElement>("#au-readonly");
    const addPanel = document.querySelector<HTMLElement>("#au-add-panel");

    let currentUid = "";
    let currentRole = "";

    function show(panel: HTMLElement | null) {
      [configPanel, loginPanel, deniedPanel, adminPanel].forEach((item) => item?.classList.add("hidden"));
      panel?.classList.remove("hidden");
    }

    function showMessage(text: string, type = "info") {
      if (!message) return;
      message.textContent = text;
      message.className = `form-message show ${type}`;
      if (type === "success") setTimeout(() => message.classList.remove("show"), 4000);
    }

    function esc(value: unknown) {
      return String(value ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
    }

    function roleLabel(role: string) {
      return role ? role.replace(/_/g, " ") : "admin (legacy)";
    }

    function isSuperAdmin(role: string) {
      return role === "super_admin" || !role;
    }

    async function audit(action: string, targetUid: string, detail: string) {
      if (!db) return;
      try {
        await addDoc(collection(db, "adminActivity"), {
          action,
          actorUid: currentUid,
          actorRole: currentRole,
          targetUid,
          detail,
          createdAt: new Date().toISOString(),
          serverCreatedAt: serverTimestamp(),
        });
      } catch {
        // The role change already succeeded; a missing audit entry must not hide that.
      }
    }

    async function loadAdmins() {
      if (!db || !list) return;
      const snapshot = await getDocs(collection(db, "admins"));
      const admins = snapshot.docs.map((item) => ({ uid: item.id, ...item.data() } as Record<string, any>));
      admins.sort((a, b) => String(a.email || a.uid).localeCompare(String(b.email || b.uid)));

      // Pull the matching public profile for each admin so role decisions have context.
      const profileSnaps = await Promise.all(
        admins.map((admin) => getDoc(doc(db, "users", admin.uid)).catch(() => null)),
      );
      const profiles = new Map<string, Record<string, any>>();
      profileSnaps.forEach((snap, index) => {
        if (snap?.exists()) profiles.set(admins[index].uid, snap.data() as Record<string, any>);
      });

      const canManage = isSuperAdmin(currentRole);
      const superCount = admins.filter((admin) => isSuperAdmin(String(admin.role || ""))).length;
      if (readonly) readonly.style.display = canManage ? "none" : "";
      if (addPanel) addPanel.style.display = canManage ? "" : "none";

      list.innerHTML = admins
        .map((admin) => {
          const role = String(admin.role || "");
          const self = admin.uid === currentUid;
          const lastSuper = isSuperAdmin(role) && superCount <= 1;
          const profile = profiles.get(admin.uid) || {};
          const profileBits = [
            profile.name ? esc(profile.name) : "",
            profile.userStatus ? `Status: ${esc(profile.userStatus)}` : "",
            profile.institutionName ? `Institution: ${esc(profile.institutionName)}` : "",
            profile.organizationName ? `Organisation: ${esc(profile.organizationName)}` : "",
            profile.stateName ? esc(profile.stateName) : "",
          ].filter(Boolean);
          const options = ["super_admin", "admin", "manager", "executive", "moderator"]
            .map((option) => `<option value="${option}" ${option === (role || "admin") ? "selected" : ""}>${roleLabel(option)}</option>`)
            .join("");
          return `
          <article class="admin-item">
            <div class="admin-item-head">
              <div>
                <h3>${esc(admin.email || admin.uid)} ${self ? '<span class="badge badge-green">You</span>' : ""}</h3>
                <div class="admin-item-meta">UID: ${esc(admin.uid)} · ${esc(roleLabel(role))}</div>
                ${profileBits.length
                  ? `<div class="admin-item-meta" style="margin-top:4px">${profileBits.join(" · ")}</div>`
                  : `<div class="admin-item-meta" style="margin-top:4px;opacity:0.7">No profile data yet · <a href="/account/">view account</a></div>`}
              </div>
              <span class="badge ${isSuperAdmin(role) ? "badge-green" : "badge-amber"}">${esc(roleLabel(role))}</span>
            </div>
            ${canManage
              ? `<div class="admin-actions" style="align-items:center">
                   <label class="small" for="role-${esc(admin.uid)}">Role</label>
                   <select class="select" id="role-${esc(admin.uid)}" data-role-for="${esc(admin.uid)}" ${lastSuper ? "disabled" : ""}>${options}</select>
                   <button class="btn btn-outline btn-sm" type="button" data-action="save-role" data-uid="${esc(admin.uid)}" ${lastSuper ? "disabled" : ""}>Save role</button>
                   ${lastSuper ? '<span class="small muted">At least one Super Admin is required.</span>' : ""}
                 </div>`
              : ""}
          </article>`;
        })
        .join("");
    }

    async function boot(user: { uid: string; email: string | null }) {
      currentUid = user.uid;
      if (!db) {
        show(configPanel);
        return;
      }
      const adminDoc = await getDoc(doc(db, "admins", user.uid));
      if (!adminDoc.exists()) {
        show(deniedPanel);
        return;
      }
      currentRole = String(adminDoc.data()?.role || "");
      show(adminPanel);
      await loadAdmins();
    }

    if (!auth || !db) {
      show(configPanel);
    } else {
      onAuthStateChanged(auth, (user) => {
        if (user) boot(user).catch(() => show(deniedPanel));
        else show(loginPanel);
      });

      document.querySelector("#au-login-form")?.addEventListener("submit", async (event) => {
        event.preventDefault();
        const email = document.querySelector<HTMLInputElement>("#au-email")?.value.trim() || "";
        const password = document.querySelector<HTMLInputElement>("#au-password")?.value || "";
        try {
          await signInWithEmailAndPassword(auth, email, password);
        } catch (error) {
          const msg = document.querySelector<HTMLElement>("#au-login-message");
          if (msg) {
            const code = (error as { code?: string })?.code || "";
            msg.textContent =
              code === "auth/invalid-credential" || code === "auth/wrong-password" || code === "auth/user-not-found"
                ? "Email or password is incorrect. Ask a Super Admin to reset your access."
                : error instanceof Error
                  ? error.message
                  : "Sign-in failed.";
            msg.className = "form-message show error";
          }
        }
      });

      document.querySelector("#au-denied-signout")?.addEventListener("click", () => signOut(auth));

      list?.addEventListener("click", async (event) => {
        const button = (event.target as HTMLElement).closest<HTMLElement>("[data-action='save-role']");
        if (!button || !db) return;
        const uid = button.dataset.uid || "";
        const select = document.querySelector<HTMLSelectElement>(`select[data-role-for="${CSS.escape(uid)}"]`);
        const role = select?.value || "admin";
        if (!uid || !confirm(`Change this admin's role to ${roleLabel(role)}?`)) return;
        try {
          await updateDoc(doc(db, "admins", uid), {
            role,
            updatedAt: new Date().toISOString(),
            serverUpdatedAt: serverTimestamp(),
          });
          await audit("role_change", uid, `Role set to ${role}`);
          showMessage("Role updated.", "success");
          await loadAdmins();
        } catch (error) {
          showMessage(error instanceof Error ? error.message : "Could not update the role.", "error");
        }
      });

      document.querySelector("#au-add-form")?.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!db) return;
        const uid = document.querySelector<HTMLInputElement>("#au-new-uid")?.value.trim() || "";
        const email = document.querySelector<HTMLInputElement>("#au-new-email")?.value.trim() || "";
        const role = document.querySelector<HTMLSelectElement>("#au-new-role")?.value || "admin";
        if (!uid) return;
        try {
          await setDoc(doc(db, "admins", uid), {
            email,
            role,
            createdAt: new Date().toISOString(),
            serverCreatedAt: serverTimestamp(),
          });
          await audit("admin_added", uid, `Added as ${role}`);
          showMessage("Admin added.", "success");
          (document.querySelector("#au-add-form") as HTMLFormElement | null)?.reset();
          await loadAdmins();
        } catch (error) {
          showMessage(error instanceof Error ? error.message : "Could not add the admin.", "error");
        }
      });
    }
  </script>
</BaseLayout>
