---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { CATEGORY_META } from "../../lib/constants";
---

<BaseLayout title="Admin review" description="FollowExam admin review queue." noindex gated={false}>
  <section class="admin-shell">
    <div class="container">
      <div id="admin-loading" class="panel">
        <p class="muted">Loading the admin workspace…</p>
      </div>

      <div id="admin-config" class="panel hidden">
        <h1 style="font-size:1.4rem">Firebase setup required</h1>
        <p>
          Configure the Firebase project to use the admin queue and alerts. Copy <code>.env.example</code> to
          <code>.env</code> and fill in the <code>PUBLIC_FIREBASE_*</code> values.
        </p>
        <p class="small muted">
          The public site still builds without Firebase; only the admin and sign-in features stay disabled.
        </p>
      </div>

      <div id="admin-login" class="form-card hidden">
        <h1>Admin sign in</h1>
        <p class="muted small">Only authorised administrators can open the review queue.</p>
        <div class="form-message" data-login-message role="status"></div>
        <form id="login-form" class="form-grid">
          <div class="field">
            <label for="login-email">Email</label>
            <input class="input" id="login-email" type="email" autocomplete="email" required />
          </div>
          <div class="field">
            <label for="login-password">Password</label>
            <input class="input" id="login-password" type="password" autocomplete="current-password" required />
          </div>
          <button class="btn btn-primary" type="submit">Sign in</button>
          <button class="btn btn-outline" type="button" id="google-login">Continue with Google</button>
          <button class="btn btn-ghost" type="button" id="create-owner">First time? Create owner account</button>
        </form>
        <p class="small muted" style="margin:12px 0 0">
          Forgot your password?
          <button class="btn btn-ghost btn-sm" type="button" id="reset-password">Send reset link</button>
        </p>
        <p class="small muted" style="margin:6px 0 0">
          Owner email: <strong>surakshasavingssociety@gmail.com</strong>. Fastest option: sign in with Google using this
          email. “Create owner account” sets an email/password on this device.
        </p>
      </div>

      <div id="admin-denied" class="form-card hidden">
        <h1>Access denied</h1>
        <p>
          You are signed in as <strong id="denied-email">—</strong> but this account is not on the admin list.
        </p>
        <p>
          Only the owner email can self-provision the first admin account. If you are the owner, sign out and sign in again
          with <strong>surakshasavingssociety@gmail.com</strong> — the admin document will be created automatically.
        </p>
        <p class="small muted">Your user ID: <code id="admin-uid"></code></p>
        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:10px">
          <button class="btn btn-outline" type="button" id="denied-signout">Sign out and try another account</button>
          <a class="btn btn-ghost" href="/login/?next=/admin/">Go to sign in</a>
        </div>
      </div>

      <div id="admin-panel" class="hidden">
        <div class="admin-head">
          <div>
            <div class="eyebrow" style="background:var(--brand-soft);color:var(--brand);border-color:transparent">
              Admin workspace
            </div>
            <h1 style="font-size:clamp(1.6rem,3vw,2.2rem);margin:6px 0 0">Review queue</h1>
            <p class="muted small" style="margin:4px 0 0">
              Verify the discovered entries, add the analysed details and official notification link, then publish.
            </p>
          </div>
          <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
            <span class="badge badge-blue" id="admin-role" style="display:none"></span>
            <a class="btn btn-ghost btn-sm" href="/admin/feature-flags/">Feature flags</a>
            <a class="btn btn-ghost btn-sm" href="/admin/payments/">Payments</a>
            <a class="btn btn-ghost btn-sm" href="/admin/social/">Social</a>
            <a class="btn btn-ghost btn-sm" href="/admin/automation/">Automation</a>
            <a class="btn btn-ghost btn-sm" href="/admin/tracking/">Tracking</a>
            <a class="btn btn-ghost btn-sm" href="/admin/institutions/">Institutions</a>
            <a class="btn btn-ghost btn-sm" href="/admin/users/">Admin users</a>
            <a class="btn btn-ghost btn-sm" href="/admin/inquiries/">Enquiries</a>
            <a class="btn btn-ghost btn-sm" href="/admin/analytics/">Analytics</a>
            <a class="btn btn-ghost btn-sm" href="/admin/settings/">Settings</a>
            <a class="btn btn-ghost btn-sm" href="/" target="_blank" rel="noopener">View site ↗</a>
            <span class="small muted" id="admin-email"></span>
            <button class="btn btn-outline btn-sm" type="button" id="admin-signout">Sign out</button>
          </div>
        </div>

        <div class="stats-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px;margin:12px 0 16px">
          <div class="panel" style="padding:12px">
            <div class="small muted">Pending</div>
            <div style="font-size:1.6rem;font-weight:700" id="stat-pending">—</div>
          </div>
          <div class="panel" style="padding:12px">
            <div class="small muted">Published</div>
            <div style="font-size:1.6rem;font-weight:700" id="stat-published">—</div>
          </div>
          <div class="panel" style="padding:12px">
            <div class="small muted">Scheduled</div>
            <div style="font-size:1.6rem;font-weight:700" id="stat-scheduled">—</div>
          </div>
          <div class="panel" style="padding:12px">
            <div class="small muted">Admins</div>
            <div style="font-size:1.6rem;font-weight:700" id="stat-admins">—</div>
          </div>
          <div class="panel" style="padding:12px">
            <div class="small muted">Subscribers</div>
            <div style="font-size:1.6rem;font-weight:700" id="stat-subscribers">—</div>
          </div>
        </div>

        <div class="admin-tabs" role="tablist">
          <button type="button" role="tab" aria-selected="true" data-tab="pending">Pending <span id="pending-count"></span></button>
          <button type="button" role="tab" aria-selected="false" data-tab="published">Published <span id="published-count"></span></button>
          <button type="button" role="tab" aria-selected="false" data-tab="add">Add manually</button>
        </div>

        <div class="form-message" id="admin-message" role="status"></div>

        <section id="tab-pending">
          <div class="filter-panel" style="padding:12px">
            <div class="filter-row" style="grid-template-columns:1.6fr 1fr">
              <div class="field">
                <label for="pending-search">Filter pending</label>
                <input class="input" id="pending-search" placeholder="Title, organisation, source…" />
              </div>
              <div class="field">
                <label for="pending-category">Category</label>
                <select class="select" id="pending-category">
                  <option value="">All</option>
                  {Object.keys(CATEGORY_META).map((category) => <option value={category}>{category}</option>)}
                </select>
              </div>
            </div>
          </div>
          <div id="pending-list" class="admin-list"></div>
        </section>

        <section id="tab-published" class="hidden">
          <div id="published-list" class="admin-list"></div>
        </section>

        <section id="tab-add" class="hidden">
          <div class="panel">
            <h2 style="font-size:1.2rem">Add an update manually</h2>
            <p class="muted small">Use this when automatic discovery misses an official notification.</p>
            <form id="add-job-form" class="admin-edit">
              <div class="field full">
                <label for="add-title">Title *</label>
                <input class="input" id="add-title" name="title" required />
              </div>
              <div class="field">
                <label for="add-org">Organisation *</label>
                <input class="input" id="add-org" name="organization" required />
              </div>
              <div class="field">
                <label for="add-category">Category *</label>
                <select class="select" id="add-category" name="category" required>
                  {Object.keys(CATEGORY_META).map((category) => <option value={category}>{category}</option>)}
                </select>
              </div>
              <div class="field">
                <label for="add-state">State</label>
                <input class="input" id="add-state" name="state" value="All India" />
              </div>
              <div class="field">
                <label for="add-qual">Qualification (comma separated)</label>
                <input class="input" id="add-qual" name="qualification" placeholder="Graduate, Class 12" />
              </div>
              <div class="field">
                <label for="add-vacancies">Vacancies</label>
                <input class="input" id="add-vacancies" name="vacancies" type="number" min="0" />
              </div>
              <div class="field">
                <label for="add-post-date">Post date *</label>
                <input class="input" id="add-post-date" name="postDate" type="date" required />
              </div>
              <div class="field">
                <label for="add-apply-start">Application starts</label>
                <input class="input" id="add-apply-start" name="applyStart" type="date" />
              </div>
              <div class="field">
                <label for="add-apply-end">Last date</label>
                <input class="input" id="add-apply-end" name="applyEnd" type="date" />
              </div>
              <div class="field">
                <label for="add-exam-date">Exam date</label>
                <input class="input" id="add-exam-date" name="examDate" type="date" />
              </div>
              <div class="field">
                <label for="add-official-url">Official website *</label>
                <input class="input" id="add-official-url" name="officialUrl" type="url" required />
              </div>
              <div class="field">
                <label for="add-notification-url">Official notification link *</label>
                <input
                  class="input"
                  id="add-notification-url"
                  name="notificationUrl"
                  type="url"
                  placeholder="https://…/notification.pdf"
                  required
                />
              </div>
              <div class="field full">
                <label for="add-summary">Summary *</label>
                <textarea class="textarea" id="add-summary" name="summary" required></textarea>
              </div>
              <div class="field full">
                <label for="add-highlights">Key points (one per line)</label>
                <textarea
                  class="textarea"
                  id="add-highlights"
                  name="highlights"
                  placeholder="Total vacancies and posts&#10;Reservation and age relaxation&#10;Selection stages"
                ></textarea>
              </div>
              <div class="field full">
                <label for="add-eligibility">Eligibility (one per line)</label>
                <textarea class="textarea" id="add-eligibility" name="eligibility"></textarea>
              </div>
              <div class="field full">
                <label for="add-how-to-apply">How to apply (one step per line)</label>
                <textarea class="textarea" id="add-how-to-apply" name="howToApply"></textarea>
              </div>
              <div class="field full">
                <label for="add-documents">Documents to keep ready (one per line)</label>
                <textarea class="textarea" id="add-documents" name="documents"></textarea>
              </div>
              <div class="field full">
                <label for="add-seo-title">SEO title (optional)</label>
                <input class="input" id="add-seo-title" name="seoTitle" />
              </div>
              <div class="field full">
                <label for="add-seo-description">SEO description (optional)</label>
                <textarea class="textarea" id="add-seo-description" name="seoDescription"></textarea>
              </div>
              <div class="field">
                <label for="add-featured-image">Featured image URL (optional)</label>
                <input class="input" id="add-featured-image" name="featuredImage" type="url" />
              </div>
              <div class="field">
                <label for="add-publish-at">Schedule publish (optional)</label>
                <input class="input" id="add-publish-at" name="publishAt" type="datetime-local" />
              </div>
              <div class="field full">
                <button class="btn btn-primary" type="submit">Publish update</button>
              </div>
            </form>
          </div>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import {
    GoogleAuthProvider,
    createUserWithEmailAndPassword,
    onAuthStateChanged,
    sendPasswordResetEmail,
    signInWithEmailAndPassword,
    signInWithPopup,
    signOut,
    type User,
  } from "firebase/auth";
  import {
    collection,
    deleteDoc,
    doc,
    getDoc,
    getDocs,
    limit,
    orderBy,
    query,
    setDoc,
    updateDoc,
    where,
  } from "firebase/firestore";
  import { firebaseConfigured, getFirebaseAuth, getFirebaseDb } from "../../lib/firebase";
  import { findDuplicateJobs } from "../../lib/duplicates";

  type PendingJob = Record<string, any>;

  const loading = document.querySelector<HTMLElement>("#admin-loading");
  const configPanel = document.querySelector<HTMLElement>("#admin-config");
  const loginPanel = document.querySelector<HTMLElement>("#admin-login");
  const deniedPanel = document.querySelector<HTMLElement>("#admin-denied");
  const adminPanel = document.querySelector<HTMLElement>("#admin-panel");
  const loginForm = document.querySelector<HTMLFormElement>("#login-form");
  const loginMessage = document.querySelector<HTMLElement>("[data-login-message]");
  const adminMessage = document.querySelector<HTMLElement>("#admin-message");
  const pendingList = document.querySelector<HTMLElement>("#pending-list");
  const publishedList = document.querySelector<HTMLElement>("#published-list");
  const pendingCount = document.querySelector<HTMLElement>("#pending-count");
  const adminEmail = document.querySelector<HTMLElement>("#admin-email");
  const pendingSearch = document.querySelector<HTMLInputElement>("#pending-search");
  const pendingCategory = document.querySelector<HTMLSelectElement>("#pending-category");
  const addForm = document.querySelector<HTMLFormElement>("#add-job-form");

  let db: ReturnType<typeof getFirebaseDb> = null;
  let currentUser: User | null = null;
let currentUserRole = "";
const OWNER_EMAIL = "surakshasavingssociety@gmail.com";

function authErrorMessage(error: unknown): string {
  const code = (error as { code?: string })?.code || "";
  switch (code) {
    case "auth/invalid-credential":
    case "auth/wrong-password":
    case "auth/user-not-found":
      return "Email or password is incorrect. Check the details, or use “Send reset link” to reset your password.";
    case "auth/invalid-email":
      return "That email address is not valid.";
    case "auth/too-many-requests":
      return "Too many attempts. Please wait a minute and try again.";
    case "auth/operation-not-allowed":
      return "Email/password sign-in is not enabled for this Firebase project. Enable it in Firebase Console → Authentication → Sign-in method.";
    case "auth/unauthorized-domain":
      return "This domain is not authorised in Firebase Authentication → Settings → Authorized domains.";
    case "auth/popup-blocked":
      return "The Google popup was blocked. Allow popups for this site and try again.";
    case "auth/popup-closed-by-user":
      return "Google sign-in was closed before it finished.";
    case "auth/network-request-failed":
      return "Network error. Check your connection and try again.";
    default:
      return error instanceof Error ? error.message : "Sign-in failed. Please try again.";
  }
}
  let pending: PendingJob[] = [];
  let published: PendingJob[] = [];
  let activeTab = "pending";

  const CATEGORIES = ["Latest Jobs", "Results", "Admit Card", "Answer Key", "Exam Date", "Admission", "Syllabus", "Scholarship"];

  function showPanel(panel: HTMLElement | null) {
    [loading, configPanel, loginPanel, deniedPanel, adminPanel].forEach((item) => item?.classList.add("hidden"));
    panel?.classList.remove("hidden");
  }

  function showMessage(element: HTMLElement | null, text: string, type: "error" | "success" | "info" = "info") {
    if (!element) return;
    element.textContent = text;
    element.className = `form-message show ${type}`;
    if (type === "success") setTimeout(() => element.classList.remove("show"), 3500);
  }

  function esc(value: unknown) {
    return String(value ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  function slugify(value: string) {
    return value
      .toLowerCase()
      .replace(/&/g, " and ")
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "")
      .slice(0, 90);
  }

  function inputValue(value: unknown, type = "text") {
    if (!value) return "";
    if (type === "date") return String(value).slice(0, 10);
    return esc(value);
  }

  function toLocalDateTimeInput(value: unknown) {
    if (!value) return "";
    const date = new Date(String(value));
    if (Number.isNaN(date.getTime())) return "";
    const pad = (input: number) => String(input).padStart(2, "0");
    return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}T${pad(date.getHours())}:${pad(date.getMinutes())}`;
  }

  function renderPending() {
    if (!pendingList) return;
    const search = (pendingSearch?.value || "").toLowerCase();
    const category = pendingCategory?.value || "";
    const filtered = pending.filter((job) => {
      const haystack = `${job.title} ${job.organization} ${job.sourceName}`.toLowerCase();
      return (!search || haystack.includes(search)) && (!category || job.category === category);
    });

    if (pendingCount) pendingCount.textContent = pending.length ? `(${pending.length})` : "";

    if (!filtered.length) {
      pendingList.innerHTML = `<div class="empty"><h3>Queue is clear</h3><p>New discovered entries appear here for review.</p></div>`;
      return;
    }

    pendingList.innerHTML = filtered
      .map(
        (job) => {
          const duplicates = findDuplicateJobs(
            job as any,
            [...published, ...pending] as any,
          )
            .filter((match) => match.strong)
            .slice(0, 3);
          const duplicateNotice = duplicates.length
            ? `<div class="panel" style="padding:10px 12px;margin-top:10px;border-left:3px solid #d97706;background:#fffbeb">
                <strong class="small">Possible duplicate</strong>
                <ul class="small" style="margin:6px 0 0;padding-left:18px">
                  ${duplicates
                    .map((match) => {
                      const candidate = match.job as any;
                      const label =
                        candidate.status === "published"
                          ? `<a href="/jobs/${esc(candidate.slug || candidate.id)}/" target="_blank">${esc(candidate.title)}</a>`
                          : `${esc(candidate.title)} <span class="muted">(in review queue)</span>`;
                      return `<li>${label} — ${Math.round(match.score * 100)}% match · ${esc(match.reasons.join(", "))}</li>`;
                    })
                    .join("")}
                </ul>
              </div>`
            : "";
          return `
      <article class="admin-item" data-id="${esc(job.id)}">
        <div class="admin-item-head">
          <div>
            <h3>${esc(job.title)}</h3>
            <div class="admin-item-meta">
              ${esc(job.organization)} · ${esc(job.category)} · ${esc(job.state || "All India")} · ${esc(job.sourceName || "source")}
            </div>
          </div>
          <span class="badge badge-amber">Pending</span>
        </div>
        ${duplicateNotice}
        <div class="admin-actions">
          <a class="btn btn-outline btn-sm" href="${esc(job.discoveryUrl || job.notificationUrl || job.officialUrl)}" target="_blank" rel="noopener">Open source ↗</a>
          <button class="btn btn-primary btn-sm" type="button" data-action="approve">Approve</button>
          <button class="btn btn-danger btn-sm" type="button" data-action="reject">Reject</button>
          <button class="btn btn-ghost btn-sm" type="button" data-action="toggle-edit">Edit fields</button>
        </div>
        <div class="admin-edit hidden" data-edit>
          <div class="field full"><label>Title</label><input class="input" data-field="title" value="${inputValue(job.title)}" /></div>
          <div class="field"><label>Organisation</label><input class="input" data-field="organization" value="${inputValue(job.organization)}" /></div>
          <div class="field"><label>Category</label><select class="select" data-field="category">${CATEGORIES.map((category) => `<option ${category === job.category ? "selected" : ""}>${category}</option>`).join("")}</select></div>
          <div class="field"><label>State</label><input class="input" data-field="state" value="${inputValue(job.state)}" /></div>
          <div class="field"><label>Qualification (comma separated)</label><input class="input" data-field="qualification" value="${inputValue((job.qualification || []).join(", "))}" /></div>
          <div class="field"><label>Vacancies</label><input class="input" type="number" min="0" data-field="vacancies" value="${inputValue(job.vacancies)}" /></div>
          <div class="field"><label>Post date</label><input class="input" type="date" data-field="postDate" value="${inputValue(job.postDate, "date")}" /></div>
          <div class="field"><label>Application starts</label><input class="input" type="date" data-field="applyStart" value="${inputValue(job.applyStart, "date")}" /></div>
          <div class="field"><label>Last date</label><input class="input" type="date" data-field="applyEnd" value="${inputValue(job.applyEnd, "date")}" /></div>
          <div class="field"><label>Exam date</label><input class="input" type="date" data-field="examDate" value="${inputValue(job.examDate, "date")}" /></div>
          <div class="field"><label>Salary</label><input class="input" data-field="salary" value="${inputValue(job.salary)}" /></div>
          <div class="field"><label>Official website</label><input class="input" type="url" data-field="officialUrl" value="${inputValue(job.officialUrl)}" /></div>
          <div class="field"><label>Official notification link</label><input class="input" type="url" data-field="notificationUrl" value="${inputValue(job.notificationUrl)}" /></div>
          <div class="field"><label>Schedule publish (optional)</label><input class="input" type="datetime-local" data-field="publishAt" value="${toLocalDateTimeInput(job.publishAt)}" /></div>
          <div class="field full"><label>Summary</label><textarea class="textarea" data-field="summary">${esc(job.summary)}</textarea></div>
        </div>
      </article>`;
        },
      )
      .join("");
  }

  async function loadPending() {
    if (!db) return;
    try {
      const snapshot = await getDocs(
        query(collection(db, "pending"), where("status", "==", "pending"), orderBy("discoveredAt", "desc"), limit(200)),
      );
      pending = snapshot.docs.map((item) => ({ id: item.id, ...item.data() }));
    } catch {
      const snapshot = await getDocs(query(collection(db, "pending"), orderBy("discoveredAt", "desc"), limit(300)));
      pending = snapshot.docs
        .map((item) => ({ id: item.id, ...item.data() }))
        .filter((item) => item.status !== "approved" && item.status !== "rejected")
        .slice(0, 200);
    }
    renderPending();
  }

  async function loadStats() {
    if (!db) return;
    const set = (id: string, value: number) => {
      const el = document.querySelector<HTMLElement>(id);
      if (el) el.textContent = String(value);
    };
    try {
      const s = await getDocs(collection(db, "pending"));
      const count = s.docs.filter((item) => (item.data().status || "pending") === "pending").length;
      set("#stat-pending", count);
    } catch {}
    try {
      const s = await getDocs(collection(db, "jobs"));
      const items = s.docs.map((item) => item.data());
      set("#stat-published", items.filter((item) => (item.status || "published") === "published").length);
      set("#stat-scheduled", items.filter((item) => item.status === "scheduled").length);
    } catch {}
    try { const s = await getDocs(collection(db, "admins")); set("#stat-admins", s.size); } catch {}
    try { const s = await getDocs(collection(db, "subscribers")); set("#stat-subscribers", s.size); } catch {}
  }

  async function loadPublished() {
    if (!db || !publishedList) return;
    try {
      const snapshot = await getDocs(query(collection(db, "jobs"), orderBy("postDate", "desc"), limit(100)));
      published = snapshot.docs.map((item) => ({ id: item.id, ...item.data() }));
    } catch {
      const snapshot = await getDocs(query(collection(db, "jobs"), limit(100)));
      published = snapshot.docs.map((item) => ({ id: item.id, ...item.data() }));
    }
    const pc = document.querySelector<HTMLElement>("#published-count");
    if (pc) pc.textContent = published.length ? `(${published.length})` : "";

    publishedList.innerHTML = published.length
      ? published
          .map((job) => {
            const isScheduled = job.status === "scheduled";
            const publishLabel = job.publishAt
              ? new Date(job.publishAt).toLocaleString("en-IN", { dateStyle: "medium", timeStyle: "short" })
              : "";
            return `
        <article class="admin-item">
          <div class="admin-item-head">
            <div>
              <h3><a href="/jobs/${esc(job.slug || job.id)}/" target="_blank">${esc(job.title)}</a></h3>
              <div class="admin-item-meta">${esc(job.organization)} · ${esc(job.category)} · ${esc(job.postDate || "")}${isScheduled && publishLabel ? ` · goes live ${esc(publishLabel)}` : ""}</div>
            </div>
            <span class="badge ${isScheduled ? "badge-amber" : "badge-green"}">${isScheduled ? "Scheduled" : "Published"}</span>
          </div>
          <div class="admin-actions">
            <a class="btn btn-outline btn-sm" href="/jobs/${esc(job.slug || job.id)}/" target="_blank">View ↗</a>
            <a class="btn btn-outline btn-sm" href="${esc(job.notificationUrl || job.officialUrl)}" target="_blank" rel="noopener">Notification ↗</a>
            ${isScheduled ? `<button class="btn btn-primary btn-sm" type="button" data-action="publish-now" data-id="${esc(job.id)}">Publish now</button>` : ""}
            <button class="btn btn-danger btn-sm" type="button" data-action="unpublish" data-id="${esc(job.id)}">Unpublish</button>
          </div>
        </article>`;
          })
          .join("")
      : `<div class="empty"><h3>Nothing published yet</h3><p>Approve the first entry from the pending queue.</p></div>`;
  }

  function readFields(container: HTMLElement) {
    const values: Record<string, any> = {};
    container.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>("[data-field]").forEach((element) => {
      const key = element.dataset.field;
      if (!key) return;
      values[key] = element.value.trim();
    });
    return values;
  }

  function normalize(values: Record<string, any>) {
    return {
      ...values,
      qualification: String(values.qualification || "")
        .split(",")
        .map((item) => item.trim())
        .filter(Boolean),
      vacancies: values.vacancies ? Number(values.vacancies) : null,
    };
  }

  async function approve(item: HTMLElement) {
    if (!db) return;
    const id = item.dataset.id;
    if (!id) return;
    const original = pending.find((job) => job.id === id);
    if (!original) return;
    const edit = item.querySelector<HTMLElement>("[data-edit]");
    const values = edit ? normalize(readFields(edit)) : {};
    const title = values.title || original.title;
    const notificationUrl = values.notificationUrl || original.notificationUrl || original.officialUrl;
    if (!title || !original.officialUrl || !notificationUrl) {
      showMessage(adminMessage, "A title, an official website and an official notification link are required.", "error");
      return;
    }

    const duplicates = findDuplicateJobs(original as any, [...published, ...pending] as any).filter(
      (match) => match.strong,
    );
    if (duplicates.length) {
      const first = duplicates[0];
      const proceed = confirm(
        `This looks like a duplicate of "${first.job.title}" (${Math.round(first.score * 100)}% match). Publish anyway?`,
      );
      if (!proceed) return;
    }

    const now = new Date().toISOString();
    const publishAtInput = values.publishAt || original.publishAt || null;
    const publishDate = publishAtInput ? new Date(publishAtInput) : null;
    const publishAt = publishDate && !Number.isNaN(publishDate.getTime()) ? publishDate.toISOString() : null;
    const isFuture = publishAt != null && new Date(publishAt).getTime() > Date.now();
    const approved = {
      ...original,
      ...values,
      id,
      slug: original.slug || slugify(title),
      title,
      notificationUrl,
      status: isFuture ? "scheduled" : "published",
      publishAt,
      demo: false,
      approvedAt: now,
      updatedAt: now,
      notified: false,
      notifiedAt: null,
    };

    await setDoc(doc(db, "jobs", id), approved, { merge: true });
    // Keep a reviewed copy in the queue instead of deleting it, so the daily
    // sync never resurrects an already-handled entry.
    await setDoc(
      doc(db, "pending", id),
      { status: "approved", approvedAt: now, updatedAt: now },
      { merge: true },
    );
    pending = pending.filter((job) => job.id !== id);
    if (!isFuture) published = [approved as any, ...published];
    renderPending();
    showMessage(
      adminMessage,
      isFuture
        ? `Scheduled for ${new Date(publishAt as string).toLocaleString("en-IN")}. It goes live automatically with the next build after that time.`
        : "Approved. The update goes live with the next site build.",
      "success",
    );
  }

  async function reject(item: HTMLElement) {
    if (!db) return;
    const id = item.dataset.id;
    if (!id) return;
    if (!confirm("Reject this entry?")) return;
    const now = new Date().toISOString();
    await setDoc(
      doc(db, "pending", id),
      { status: "rejected", reviewedAt: now, updatedAt: now },
      { merge: true },
    );
    pending = pending.filter((job) => job.id !== id);
    renderPending();
    showMessage(adminMessage, "Entry rejected.", "info");
  }

  async function unpublish(id: string) {
    if (!db) return;
    if (!confirm("Unpublish this update? It will be removed from the site.")) return;
    await deleteDoc(doc(db, "jobs", id));
    published = published.filter((job) => job.id !== id);
    await loadPublished();
    showMessage(adminMessage, "Update unpublished.", "info");
  }

  function switchTab(tab: string) {
    activeTab = tab;
    document.querySelectorAll<HTMLButtonElement>("[data-tab]").forEach((button) => {
      button.setAttribute("aria-selected", String(button.dataset.tab === tab));
    });
    document.querySelector<HTMLElement>("#tab-pending")?.classList.toggle("hidden", tab !== "pending");
    document.querySelector<HTMLElement>("#tab-published")?.classList.toggle("hidden", tab !== "published");
    document.querySelector<HTMLElement>("#tab-add")?.classList.toggle("hidden", tab !== "add");
    if (tab === "published") loadPublished();
  }

  function showDenied(user: User) {
    const deniedEmail = document.querySelector<HTMLElement>("#denied-email");
    const uidEl = document.querySelector<HTMLElement>("#admin-uid");
    if (deniedEmail) deniedEmail.textContent = user.email || user.displayName || "this account";
    if (uidEl) uidEl.textContent = user.uid || "unknown";
    showPanel(deniedPanel);
  }

  async function boot(user: User) {
    currentUser = user;
    if (adminEmail) adminEmail.textContent = user.email || "";
    if (!db) {
      showPanel(configPanel);
      return;
    }

    try {
      if (!user.uid) { showDenied(user); return; }
      let adminDoc = await getDoc(doc(db, "admins", user.uid));

      // Owner bootstrap: first sign-in with the owner email creates the admin
      // document, so there is no chicken-and-egg lockout.
      if (!adminDoc.exists() && (user.email || "").toLowerCase() === OWNER_EMAIL) {
        await setDoc(
          doc(db, "admins", user.uid),
          { email: user.email, role: "super_admin", createdAt: new Date().toISOString() },
          { merge: true },
        );
        adminDoc = await getDoc(doc(db, "admins", user.uid));
      }

      if (!adminDoc.exists()) { showDenied(user); return; }
      const role = (adminDoc.data()?.role as string) || "admin";
      currentUserRole = role;
      const roleBadge = document.querySelector<HTMLElement>("#admin-role");
      if (roleBadge) {
        roleBadge.textContent = role.replace(/_/g, " ");
        roleBadge.style.display = "";
      }
      showPanel(adminPanel);
      await loadPending();
      await loadPublished();
      loadStats();
    } catch (error) {
      showDenied(user);
      console.error(error);
    }
  }

  if (!firebaseConfigured) {
    showPanel(configPanel);
  } else {
    const auth = getFirebaseAuth();
    db = getFirebaseDb();

    if (!auth || !db) {
      showPanel(configPanel);
    } else {
      onAuthStateChanged(auth, (user) => {
        if (user) boot(user);
        else showPanel(loginPanel);
      });

      loginForm?.addEventListener("submit", async (event) => {
        event.preventDefault();
        const email = document.querySelector<HTMLInputElement>("#login-email")?.value.trim() || "";
        const password = document.querySelector<HTMLInputElement>("#login-password")?.value || "";
        try {
          showMessage(loginMessage, "Signing in…", "info");
          await signInWithEmailAndPassword(auth, email, password);
        } catch (error) {
          showMessage(loginMessage, authErrorMessage(error), "error");
        }
      });

      document.querySelector("#reset-password")?.addEventListener("click", async () => {
        const email = document.querySelector<HTMLInputElement>("#login-email")?.value.trim() || "";
        if (!email) {
          showMessage(loginMessage, "Enter your email address first, then press “Send reset link”.", "error");
          return;
        }
        try {
          await sendPasswordResetEmail(auth, email);
          showMessage(loginMessage, `Password reset link sent to ${email}. Check your inbox and spam folder.`, "success");
        } catch (error) {
          showMessage(loginMessage, authErrorMessage(error), "error");
        }
      });

      document.querySelector("#google-login")?.addEventListener("click", async () => {
        try {
          await signInWithPopup(auth, new GoogleAuthProvider());
        } catch (error) {
          showMessage(loginMessage, authErrorMessage(error), "error");
        }
      });

      document.querySelector("#create-owner")?.addEventListener("click", async () => {
        const email = document.querySelector<HTMLInputElement>("#login-email")?.value.trim().toLowerCase() || "";
        const password = document.querySelector<HTMLInputElement>("#login-password")?.value || "";

        if (email !== OWNER_EMAIL) {
          showMessage(loginMessage, `Owner account can only be created for ${OWNER_EMAIL}. Enter that email above first.`, "error");
          return;
        }
        if (password.length < 6) {
          showMessage(loginMessage, "Choose a password with at least 6 characters in the Password field, then press “Create owner account”.", "error");
          return;
        }

        try {
          showMessage(loginMessage, "Creating owner account…", "info");
          await createUserWithEmailAndPassword(auth, email, password);
          showMessage(loginMessage, "Owner account created. Signing you in…", "success");
        } catch (error) {
          const code = (error as { code?: string })?.code || "";
          if (code === "auth/email-already-in-use") {
            showMessage(
              loginMessage,
              `An account already exists for ${OWNER_EMAIL}. Use “Continue with Google” with that email, or “Send reset link” to set a password.`,
              "error",
            );
          } else {
            showMessage(loginMessage, authErrorMessage(error), "error");
          }
        }
      });

      document.querySelector("#admin-signout")?.addEventListener("click", () => signOut(auth));
      document.querySelector("#denied-signout")?.addEventListener("click", () => signOut(auth));
    }
  }

  pendingSearch?.addEventListener("input", renderPending);
  pendingCategory?.addEventListener("change", renderPending);
  document.querySelectorAll<HTMLButtonElement>("[data-tab]").forEach((button) => {
    button.addEventListener("click", () => switchTab(button.dataset.tab || "pending"));
  });

  pendingList?.addEventListener("click", async (event) => {
    const target = (event.target as HTMLElement).closest<HTMLElement>("[data-action]");
    if (!target) return;
    const item = target.closest<HTMLElement>(".admin-item");
    if (!item) return;
    const action = target.dataset.action;
    if (action === "toggle-edit") {
      item.querySelector("[data-edit]")?.classList.toggle("hidden");
    } else if (action === "approve") {
      target.setAttribute("disabled", "true");
      try {
        await approve(item);
      } catch (error) {
        showMessage(adminMessage, error instanceof Error ? error.message : "Approval failed.", "error");
      } finally {
        target.removeAttribute("disabled");
      }
    } else if (action === "reject") {
      try {
        await reject(item);
      } catch (error) {
        showMessage(adminMessage, error instanceof Error ? error.message : "Rejection failed.", "error");
      }
    }
  });

  publishedList?.addEventListener("click", async (event) => {
    const target = (event.target as HTMLElement).closest<HTMLElement>("[data-action]");
    if (!target || !db) return;
    const id = target.dataset.id;
    if (!id) return;
    if (target.dataset.action === "unpublish") {
      await unpublish(id);
    } else if (target.dataset.action === "publish-now") {
      try {
        await updateDoc(doc(db, "jobs", id), {
          status: "published",
          publishAt: null,
          updatedAt: new Date().toISOString(),
        });
        await loadPublished();
        showMessage(adminMessage, "Published now. It appears on the site after the next build.", "success");
      } catch (error) {
        showMessage(adminMessage, error instanceof Error ? error.message : "Could not publish.", "error");
      }
    }
  });

  addForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!db) return;
    const data = new FormData(addForm);
    const title = String(data.get("title") || "").trim();
    const notificationUrl = String(data.get("notificationUrl") || "").trim();
    if (!notificationUrl) {
      showMessage(adminMessage, "Add the official notification link before publishing.", "error");
      return;
    }
    const lines = (key: string) =>
      String(data.get(key) || "")
        .split("\n")
        .map((item) => item.trim())
        .filter(Boolean);

    const duplicates = findDuplicateJobs(
      {
        id: "__new__",
        title,
        organization: String(data.get("organization") || "").trim(),
        notificationUrl,
        officialUrl: String(data.get("officialUrl") || "").trim(),
        postDate: String(data.get("postDate") || new Date().toISOString().slice(0, 10)),
      } as any,
      published as any,
    ).filter((match) => match.strong);
    if (duplicates.length) {
      const first = duplicates[0];
      const proceed = confirm(
        `A similar update is already published: "${first.job.title}" (${Math.round(first.score * 100)}% match). Publish anyway?`,
      );
      if (!proceed) return;
    }
    const id = `manual-${Date.now().toString(36)}`;
    const now = new Date().toISOString();
    const publishAtInput = String(data.get("publishAt") || "") || null;
    const publishDate = publishAtInput ? new Date(publishAtInput) : null;
    const publishAt = publishDate && !Number.isNaN(publishDate.getTime()) ? publishDate.toISOString() : null;
    const isFuture = publishAt != null && new Date(publishAt).getTime() > Date.now();
    const seoTitle = String(data.get("seoTitle") || "").trim() || null;
    const seoDescription = String(data.get("seoDescription") || "").trim() || null;
    const featuredImage = String(data.get("featuredImage") || "").trim() || null;
    try {
      await setDoc(doc(db, "jobs", id), {
        id,
        slug: slugify(title),
        title,
        organization: String(data.get("organization") || "").trim(),
        category: String(data.get("category") || "Latest Jobs"),
        state: String(data.get("state") || "All India").trim(),
        qualification: String(data.get("qualification") || "")
          .split(",")
          .map((item) => item.trim())
          .filter(Boolean),
        vacancies: data.get("vacancies") ? Number(data.get("vacancies")) : null,
        postDate: String(data.get("postDate") || now.slice(0, 10)),
        applyStart: String(data.get("applyStart") || "") || null,
        applyEnd: String(data.get("applyEnd") || "") || null,
        examDate: String(data.get("examDate") || "") || null,
        fee: {},
        age: {},
        salary: "",
        summary: String(data.get("summary") || "").trim(),
        highlights: lines("highlights"),
        eligibility: lines("eligibility"),
        howToApply: lines("howToApply"),
        documents: lines("documents"),
        officialUrl: String(data.get("officialUrl") || "").trim(),
        seoTitle,
        seoDescription,
        featuredImage,
        publishAt,
        notificationUrl,
        sourceName: "Manual entry",
        status: isFuture ? "scheduled" : "published",
        demo: false,
        createdAt: now,
        updatedAt: now,
        notified: false,
      });
      addForm.reset();
      showMessage(
        adminMessage,
        isFuture
          ? `Scheduled for ${new Date(publishAt as string).toLocaleString("en-IN")}. It goes live with the next build after that time.`
          : "Update published. It appears on the site after the next build.",
        "success",
      );
    } catch (error) {
      showMessage(adminMessage, error instanceof Error ? error.message : "Save failed.", "error");
    }
  });
</script>
