---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { jobs, scheduledJobs } from "../../lib/jobs";
import fs from "node:fs";
import path from "node:path";

const pendingFile = path.join(process.cwd(), "data", "pending.json");
let pendingCount = 0;
try {
  const pending = JSON.parse(fs.readFileSync(pendingFile, "utf8")) as unknown[];
  pendingCount = pending.length;
} catch {
  pendingCount = 0;
}

const scheduled = scheduledJobs();
const byCategory = new Map<string, number>();
const byState = new Map<string, number>();
const byExam = new Map<string, number>();
let vacancies = 0;
let featured = 0;

const now = new Date();
const in30Days = new Date(now.getTime() + 30 * 86_400_000);
const imminent = jobs
  .filter((job) => {
    if (!job.applyEnd) return false;
    const end = new Date(job.applyEnd);
    return !Number.isNaN(end.getTime()) && end >= now && end <= in30Days;
  })
  .sort((a, b) => String(a.applyEnd).localeCompare(String(b.applyEnd)));

for (const job of jobs) {
  byCategory.set(job.category, (byCategory.get(job.category) || 0) + 1);
  byState.set(job.state || "All India", (byState.get(job.state || "All India") || 0) + 1);
  if (job.examName) byExam.set(job.examName, (byExam.get(job.examName) || 0) + 1);
  if (typeof job.vacancies === "number") vacancies += job.vacancies;
  if (job.featured) featured += 1;
}

const categories = [...byCategory.entries()].sort((a, b) => b[1] - a[1]);
const states = [...byState.entries()].sort((a, b) => b[1] - a[1]).slice(0, 12);
const exams = [...byExam.entries()].sort((a, b) => b[1] - a[1]).slice(0, 10);
---

<BaseLayout title="Analytics" description="Content and audience analytics (admin only)." noindex>
  <section class="section-tight" style="padding-top:30px">
    <div class="container">
      <div class="breadcrumb" style="padding:0 0 14px">
        <a href="/">Dashboard</a><span>/</span>
        <a href="/admin/">Admin</a><span>/</span><span>Analytics</span>
      </div>

      <div class="section-head" style="margin-bottom:18px">
        <div>
          <div class="eyebrow">Admin</div>
          <h1 style="font-size:clamp(1.8rem,3.6vw,2.5rem)">Analytics</h1>
          <p>Content coverage and audience numbers. No third-party tracking scripts are used.</p>
        </div>
      </div>

      <div class="stats-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px;margin:0 0 18px">
        <div class="panel" style="padding:12px"><div class="small muted">Published</div><div style="font-size:1.6rem;font-weight:700">{jobs.length}</div></div>
        <div class="panel" style="padding:12px"><div class="small muted">Scheduled</div><div style="font-size:1.6rem;font-weight:700">{scheduled.length}</div></div>
        <div class="panel" style="padding:12px"><div class="small muted">Pending queue (data)</div><div style="font-size:1.6rem;font-weight:700">{pendingCount}</div></div>
        <div class="panel" style="padding:12px"><div class="small muted">Vacancies listed</div><div style="font-size:1.6rem;font-weight:700">{vacancies ? vacancies.toLocaleString("en-IN") : "—"}</div></div>
        <div class="panel" style="padding:12px"><div class="small muted">Featured</div><div style="font-size:1.6rem;font-weight:700">{featured}</div></div>
      </div>

      <div class="panel" style="margin-bottom:18px">
        <h3 style="margin:0 0 8px">Audience (live from Firestore)</h3>
        <div id="an-config" class="hidden"><p class="small muted">Firebase is not configured.</p></div>
        <div id="an-guest" class="hidden"><p class="small muted">Sign in as an admin to load audience counts.</p></div>
        <div id="an-live" class="stats-grid hidden" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px">
          <div><span class="small muted">Registered users</span><div style="font-size:1.4rem;font-weight:700" id="an-users">—</div></div>
          <div><span class="small muted">Subscribers</span><div style="font-size:1.4rem;font-weight:700" id="an-subscribers">—</div></div>
          <div><span class="small muted">Admins</span><div style="font-size:1.4rem;font-weight:700" id="an-admins">—</div></div>
          <div><span class="small muted">New enquiries</span><div style="font-size:1.4rem;font-weight:700" id="an-inquiries">—</div></div>
        </div>
        <div id="an-breakdown" class="hidden" style="margin-top:14px"></div>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:16px">
        <div class="panel">
          <h3 style="margin:0 0 8px">By category</h3>
          {categories.length ? (
            <table style="width:100%;border-collapse:collapse;font-size:0.9rem">
              <tbody>
                {categories.map(([name, count]) => (
                  <tr style="border-bottom:1px solid var(--line)"><td style="padding:7px 0">{name}</td><td style="padding:7px 0;text-align:right;font-weight:600">{count}</td></tr>
                ))}
              </tbody>
            </table>
          ) : <p class="small muted">No published entries yet.</p>}
        </div>

        <div class="panel">
          <h3 style="margin:0 0 8px">By state</h3>
          {states.length ? (
            <table style="width:100%;border-collapse:collapse;font-size:0.9rem">
              <tbody>
                {states.map(([name, count]) => (
                  <tr style="border-bottom:1px solid var(--line)"><td style="padding:7px 0">{name}</td><td style="padding:7px 0;text-align:right;font-weight:600">{count}</td></tr>
                ))}
              </tbody>
            </table>
          ) : <p class="small muted">No published entries yet.</p>}
        </div>

        <div class="panel">
          <h3 style="margin:0 0 8px">By exam</h3>
          {exams.length ? (
            <table style="width:100%;border-collapse:collapse;font-size:0.9rem">
              <tbody>
                {exams.map(([name, count]) => (
                  <tr style="border-bottom:1px solid var(--line)"><td style="padding:7px 0">{name}</td><td style="padding:7px 0;text-align:right;font-weight:600">{count}</td></tr>
                ))}
              </tbody>
            </table>
          ) : <p class="small muted">No matched exams yet.</p>}
        </div>
      </div>

      <div class="panel" style="margin-top:18px">
        <h3 style="margin:0 0 8px">Closing in the next 30 days</h3>
        {imminent.length ? (
          <div style="overflow-x:auto">
            <table style="width:100%;border-collapse:collapse;font-size:0.9rem">
              <thead>
                <tr style="text-align:left;border-bottom:1px solid var(--line)">
                  <th style="padding:8px">Update</th><th style="padding:8px">Organisation</th><th style="padding:8px">Last date</th>
                </tr>
              </thead>
              <tbody>
                {imminent.map((job) => (
                  <tr style="border-bottom:1px solid var(--line)">
                    <td style="padding:8px"><a href={`/jobs/${job.slug}/`}>{job.title}</a></td>
                    <td style="padding:8px">{job.organization}</td>
                    <td style="padding:8px">{new Date(job.applyEnd as string).toLocaleDateString("en-IN")}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : <p class="small muted">No application deadlines in this window.</p>}
      </div>
    </div>
  </section>

  <script>
    import { onAuthStateChanged } from "firebase/auth";
    import { collection, doc, getDoc, getDocs } from "firebase/firestore";
    import { getFirebaseAuth, getFirebaseDb } from "../../lib/firebase";

    const auth = getFirebaseAuth();
    const db = getFirebaseDb();
    const configPanel = document.querySelector<HTMLElement>("#an-config");
    const guestPanel = document.querySelector<HTMLElement>("#an-guest");
    const livePanel = document.querySelector<HTMLElement>("#an-live");
    const breakdown = document.querySelector<HTMLElement>("#an-breakdown");

    function setText(id: string, value: number) {
      const element = document.querySelector<HTMLElement>(id);
      if (element) element.textContent = value.toLocaleString("en-IN");
    }

    async function count(collectionName: string, filter?: (data: Record<string, any>) => boolean) {
      const snapshot = await getDocs(collection(db!, collectionName));
      const docs = snapshot.docs.map((item) => item.data() as Record<string, any>);
      return filter ? docs.filter(filter).length : docs.length;
    }

    async function loadAudience() {
      if (!db) {
        configPanel?.classList.remove("hidden");
        return;
      }
      if (!auth?.currentUser) {
        guestPanel?.classList.remove("hidden");
        return;
      }
      const adminDoc = await getDoc(doc(db, "admins", auth.currentUser.uid));
      if (!adminDoc.exists()) {
        guestPanel?.classList.remove("hidden");
        return;
      }
      livePanel?.classList.remove("hidden");
      try {
        setText("#an-users", await count("users"));
        setText("#an-subscribers", await count("subscribers", (item) => item.active !== false));
        setText("#an-admins", await count("admins"));
        setText("#an-inquiries", await count("inquiries", (item) => (item.status || "new") === "new"));
      } catch {
        // Counts need the admin read rules; leave the placeholders visible.
      }

      try {
        const snapshot = await getDocs(collection(db, "users"));
        const categories = new Map<string, number>();
        snapshot.docs.forEach((item) => {
          const category = String(item.data().userCategory || "Not set");
          categories.set(category, (categories.get(category) || 0) + 1);
        });
        if (categories.size && breakdown) {
          const rows = [...categories.entries()].sort((a, b) => b[1] - a[1]).slice(0, 10);
          breakdown.innerHTML = `<h4 style="margin:0 0 6px;font-size:0.95rem">Users by category</h4>
            <table style="width:100%;border-collapse:collapse;font-size:0.88rem"><tbody>
            ${rows.map(([name, total]) => `<tr style="border-bottom:1px solid var(--line)"><td style="padding:6px 0">${name.replace(/</g, "&lt;")}</td><td style="padding:6px 0;text-align:right;font-weight:600">${total}</td></tr>`).join("")}
            </tbody></table>`;
          breakdown.classList.remove("hidden");
        }
      } catch {
        // Optional breakdown.
      }
    }

    if (!auth || !db) configPanel?.classList.remove("hidden");
    else onAuthStateChanged(auth, () => loadAudience());
  </script>
</BaseLayout>
