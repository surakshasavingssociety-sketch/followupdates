---
import BaseLayout from "../layouts/BaseLayout.astro";
import LoginPanel from "../components/LoginPanel.astro";
import JobCard from "../components/JobCard.astro";
import ExamCard from "../components/ExamCard.astro";
import ScholarshipCard from "../components/ScholarshipCard.astro";
import InstitutionCard from "../components/InstitutionCard.astro";
import { SITE } from "../lib/constants";
import { examDatabase, getExam } from "../lib/exams";
import { institutionDatabase, institutions } from "../lib/institutions";
import { jobs } from "../lib/jobs";
import { centralScholarships, scholarshipDatabase } from "../lib/scholarships";

const latest = jobs.slice(0, 6);

const featuredExamIds = ["ssc-cgl", "upsc-cse", "ibps-po", "rrb-ntpc", "neet-ug", "ctet"];
const featuredExams = featuredExamIds
  .map((id) => getExam(id))
  .filter((exam): exam is NonNullable<typeof exam> => Boolean(exam));

const featuredScholarships = centralScholarships().slice(0, 4);
const featuredInstitutions = institutions
  .filter((institution) => ["iit", "nit", "aiims", "iim", "nlu"].includes(institution.type))
  .slice(0, 6);

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: SITE.name,
  applicationCategory: "EducationalApplication",
  operatingSystem: "Web, Android",
  url: SITE.url,
  description: SITE.description,
  offers: { "@type": "Offer", price: "0", priceCurrency: "INR" },
};
---

<BaseLayout schema={schema} gated={false}>
  <div class="container">
    <!-- Signed-out view: the login screen is the home page. -->
    <div id="home-auth" class="home-auth">
      <div class="home-intro">
        <div class="eyebrow">Free government exam and career portal</div>
        <h1>
          Every government exam.<br />
          <span>One account.</span>
        </h1>
        <p>
          Sign in to follow official notifications for central and state recruitment, scholarships, universities and
          entrance exams. Build a profile, get a career roadmap and never miss a deadline.
        </p>
        <ul class="home-points">
          <li><strong>{jobs.length}</strong> analysed notifications with official links</li>
          <li><strong>{examDatabase.counts.total}</strong> exam cycles across {examDatabase.counts.states} states and UTs</li>
          <li><strong>{institutionDatabase.counts.total}</strong> IITs, NITs, IIITs, AIIMS, IIMs, NLUs and universities</li>
          <li><strong>{scholarshipDatabase.counts.total}</strong> central and state scholarship schemes</li>
        </ul>
        <p class="small muted">
          Already on a phone? Add FollowExam to your home screen from the browser menu, or install the Android app when
          it is available on Google Play.
        </p>
      </div>

      <LoginPanel />
    </div>

    <!-- Signed-in view: the dashboard. -->
    <div id="home-dashboard" class="home-dashboard" hidden>
      <section class="dash-head">
        <div>
          <div class="eyebrow">Your dashboard</div>
          <h1>Welcome back, <span id="dash-name">student</span>.</h1>
          <p class="muted" id="dash-subtitle">
            Here are the latest official notifications, scholarships and institutions that match your profile.
          </p>
        </div>
        <div class="dash-head-actions">
          <a class="btn btn-primary" href="/profile/">Edit profile</a>
          <a class="btn btn-outline" href="/career/">Career roadmap</a>
        </div>
      </section>

      <section class="dash-stats" aria-label="Coverage">
        <a class="dash-stat" href="/jobs/">
          <span>Analysed notifications</span>
          <strong>{jobs.length}</strong>
        </a>
        <a class="dash-stat" href="/exams/">
          <span>Exam cycles</span>
          <strong>{examDatabase.counts.total}</strong>
        </a>
        <a class="dash-stat" href="/institutions/">
          <span>Institutions</span>
          <strong>{institutionDatabase.counts.total}</strong>
        </a>
        <a class="dash-stat" href="/scholarships/">
          <span>Scholarships</span>
          <strong>{scholarshipDatabase.counts.total}</strong>
        </a>
      </section>

      <div class="dash-grid">
        <section class="panel dash-panel">
          <div class="section-head" style="margin-bottom:12px">
            <div>
              <h2>Your profile</h2>
              <p>Keep this up to date so recommendations stay accurate.</p>
            </div>
            <a class="link-arrow" href="/profile/">Open →</a>
          </div>
          <div class="facts" id="dash-profile-facts">
            <div><span>Education level</span><strong id="dash-level">Not set</strong></div>
            <div><span>State</span><strong id="dash-state">Not set</strong></div>
            <div><span>Career goal</span><strong id="dash-goal">Not decided</strong></div>
            <div><span>Profile completion</span><strong id="dash-completion">0%</strong></div>
          </div>
          <div class="progress" aria-hidden="true"><span id="dash-progress-bar" style="width:0%"></span></div>
          <p class="small muted" style="margin:12px 0 0">
            <a href="/career/">See the step-by-step roadmap for your goal →</a>
          </p>
        </section>

        <section class="panel dash-panel dash-career">
          <div class="section-head" style="margin-bottom:12px">
            <div>
              <h2>Career roadmap</h2>
              <p id="dash-career-title">Explore the paths open to your current class.</p>
            </div>
            <a class="link-arrow" href="/career/">Full roadmap →</a>
          </div>
          <ol class="dash-stages" id="dash-stages">
            <li><strong>Set your education level</strong><span>Open your profile and tell us which class or degree you are in.</span></li>
            <li><strong>Pick a career goal</strong><span>Engineering, medical, civil services, defence, banking, law, teaching and more.</span></li>
            <li><strong>Follow the milestones</strong><span>Each goal shows the exams, institutions and application steps in order.</span></li>
          </ol>
        </section>
      </div>

      <section class="section-tight">
        <div class="section-head">
          <div>
            <h2>Recommended exams</h2>
            <p>Based on your education level and career goal.</p>
          </div>
          <a class="link-arrow" href="/exams/">All exams →</a>
        </div>
        <div class="grid-3" id="dash-exams">
          {featuredExams.map((exam) => <ExamCard exam={exam} />)}
        </div>
      </section>

      <section class="section-tight">
        <div class="section-head">
          <div>
            <h2>Latest official updates</h2>
            <p>Every post includes the official notification link and a full analysis.</p>
          </div>
          <a class="link-arrow" href="/jobs/">All updates →</a>
        </div>
        {latest.length ? (
          <div class="grid-3">
            {latest.map((job) => <JobCard job={job} />)}
          </div>
        ) : (
          <div class="empty">
            <h3>No published updates yet</h3>
            <p>New notifications appear here as soon as they are analysed.</p>
          </div>
        )}
      </section>

      <section class="section-tight">
        <div class="section-head">
          <div>
            <h2>Scholarships for you</h2>
            <p>Central schemes plus the flagship programme of every state and UT.</p>
          </div>
          <a class="link-arrow" href="/scholarships/">All scholarships →</a>
        </div>
        <div class="grid-3" id="dash-scholarships">
          {featuredScholarships.map((scholarship) => <ScholarshipCard scholarship={scholarship} />)}
        </div>
      </section>

      <section class="section-tight">
        <div class="section-head">
          <div>
            <h2>Institutions to target</h2>
            <p>Admission routes, official portals and entrance exams.</p>
          </div>
          <a class="link-arrow" href="/institutions/">All institutions →</a>
        </div>
        <div class="grid-3" id="dash-institutions">
          {featuredInstitutions.map((institution) => <InstitutionCard institution={institution} />)}
        </div>
      </section>

      <section class="section-tight">
        <div class="panel dash-links">
          <a class="dash-link" href="/account/"><strong>Saved updates</strong><span>Everything you bookmarked.</span></a>
          <a class="dash-link" href="/states/"><strong>Your state</strong><span>PSC, police, TET and board exams.</span></a>
          <a class="dash-link" href="/calendar/"><strong>Exam calendar</strong><span>Notification, exam and result months.</span></a>
          <a class="dash-link" href="/category/scholarship/"><strong>Scholarship updates</strong><span>New schemes and deadlines.</span></a>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  import { watchAuth } from "../lib/auth";
  import { signOutUser } from "../lib/auth";
  import {
    CAREER_PATHS,
    loadProfile,
    recommendedExams,
    recommendedInstitutions,
    recommendedScholarships,
    type CareerPath,
  } from "../lib/profile";
  import type { Exam, Institution, Scholarship, UserProfile } from "../lib/types";

  const authView = document.querySelector<HTMLElement>("#home-auth");
  const dashboard = document.querySelector<HTMLElement>("#home-dashboard");
  const nameEl = document.querySelector<HTMLElement>("#dash-name");

  function setText(id: string, value: string) {
    const element = document.querySelector<HTMLElement>(id);
    if (element) element.textContent = value;
  }

  function initials(name: string) {
    return (
      name
        .split(/\s+/)
        .filter(Boolean)
        .slice(0, 2)
        .map((part) => part[0]?.toUpperCase() || "")
        .join("") || "FE"
    );
  }

  function escapeHtml(value: string) {
    return value
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  function completion(profile: UserProfile | null) {
    const fields = [
      profile?.name,
      profile?.stateId,
      profile?.educationLevel,
      profile?.careerGoal,
      profile?.stream,
      profile?.dateOfBirth,
    ];
    const filled = fields.filter((value) => Boolean(value && String(value).trim())).length;
    return Math.round((filled / fields.length) * 100);
  }

  function renderStages(path: CareerPath | undefined) {
    const list = document.querySelector<HTMLElement>("#dash-stages");
    if (!list || !path) return;
    list.innerHTML = path.stages
      .map(
        (stage) =>
          `<li><strong>${escapeHtml(stage.label)}</strong><span>${escapeHtml(stage.detail)}</span></li>`,
      )
      .join("");
  }

  function examCard(exam: Exam) {
    return `<article class="exam-card">
      <div class="job-card-top">
        <span class="badge badge-blue">${escapeHtml(exam.streamName)}</span>
        <span class="badge badge-muted">${escapeHtml(exam.scope === "state" ? exam.stateName || "State" : "All India")}</span>
      </div>
      <h3><a href="/exams/${encodeURIComponent(exam.slug)}/">${escapeHtml(exam.name)}</a></h3>
      <p class="exam-full">${escapeHtml(exam.fullName)}</p>
      <div class="exam-facts"><span>🏛 ${escapeHtml(exam.bodyShort)}</span><span>🎓 ${escapeHtml(exam.level)}</span></div>
    </article>`;
  }

  function scholarshipCard(scholarship: Scholarship) {
    const scope = scholarship.scope === "central" ? "Central scheme" : scholarship.stateName || "State scheme";
    return `<article class="scholarship-card">
      <div class="job-card-top">
        <span class="badge ${scholarship.scope === "central" ? "badge-green" : "badge-blue"}">${escapeHtml(scope)}</span>
        <span class="badge badge-muted">${escapeHtml(scholarship.level[0] || "All levels")}</span>
      </div>
      <h3><a href="/scholarships/${encodeURIComponent(scholarship.slug)}/">${escapeHtml(scholarship.name)}</a></h3>
      <div class="job-org"><span aria-hidden="true">🏛</span>${escapeHtml(scholarship.provider)}</div>
      <p class="small muted" style="margin:8px 0 0">${escapeHtml(scholarship.amount)}</p>
      <div class="card-foot">
        <a class="link-arrow" href="/scholarships/${encodeURIComponent(scholarship.slug)}/">View scheme →</a>
        <a class="link-arrow" href="${escapeHtml(scholarship.portalUrl)}" target="_blank" rel="noopener nofollow">Official portal ↗</a>
      </div>
    </article>`;
  }

  function institutionCard(institution: Institution) {
    return `<article class="institution-card">
      <div class="job-card-top">
        <span class="badge badge-blue">${escapeHtml(institution.typeName)}</span>
        <span class="badge badge-muted">${escapeHtml(institution.stateName)}</span>
      </div>
      <h3><a href="/institutions/${encodeURIComponent(institution.slug)}/">${escapeHtml(institution.shortName)}</a></h3>
      <p class="exam-full">${escapeHtml(institution.name)}</p>
      <div class="job-meta"><span>📍 ${escapeHtml(institution.city)}</span><span>🎓 ${escapeHtml(institution.level)}</span></div>
      <div class="card-foot">
        <a class="link-arrow" href="/institutions/${encodeURIComponent(institution.slug)}/">View institution →</a>
        <a class="link-arrow" href="${escapeHtml(institution.website)}" target="_blank" rel="noopener nofollow">Website ↗</a>
      </div>
    </article>`;
  }

  async function personalise(profile: UserProfile | null) {
    const path = CAREER_PATHS[profile?.careerGoal || "Not decided"];
    setText("#dash-level", profile?.educationLevel || "Not set");
    setText("#dash-state", profile?.stateName || "Not set");
    setText("#dash-goal", profile?.careerGoal || "Not decided");
    setText("#dash-career-title", path.title === "Still exploring" ? "Explore the paths open to your current class." : path.description);
    renderStages(path);

    const percent = completion(profile);
    setText("#dash-completion", `${percent}%`);
    const bar = document.querySelector<HTMLElement>("#dash-progress-bar");
    if (bar) bar.style.width = `${percent}%`;

    if (!profile) return;

    try {
      const [examResponse, institutionResponse, scholarshipResponse] = await Promise.all([
        fetch("/exams.json"),
        fetch("/institutions.json"),
        fetch("/scholarships.json"),
      ]);
      const examData = await examResponse.json();
      const institutionData = await institutionResponse.json();
      const scholarshipData = await scholarshipResponse.json();

      const exams = recommendedExams(profile, examData.exams || []);
      const institutions = recommendedInstitutions(profile, institutionData.institutions || []);
      const scholarships = recommendedScholarships(profile, scholarshipData.scholarships || []);

      const examTarget = document.querySelector<HTMLElement>("#dash-exams");
      if (examTarget && exams.length) examTarget.innerHTML = exams.map(examCard).join("");

      const institutionTarget = document.querySelector<HTMLElement>("#dash-institutions");
      if (institutionTarget && institutions.length) {
        institutionTarget.innerHTML = institutions.map(institutionCard).join("");
      }

      const scholarshipTarget = document.querySelector<HTMLElement>("#dash-scholarships");
      if (scholarshipTarget && scholarships.length) {
        scholarshipTarget.innerHTML = scholarships.map(scholarshipCard).join("");
      }
    } catch {
      /* Server-rendered defaults stay in place. */
    }
  }

  watchAuth(async (user) => {
    if (!user) {
      if (authView) authView.hidden = false;
      if (dashboard) dashboard.hidden = true;
      return;
    }

    if (authView) authView.hidden = true;
    if (dashboard) dashboard.hidden = false;

    const profile = await loadProfile(user);
    const displayName = profile?.name || user.displayName || user.email?.split("@")[0] || "student";
    if (nameEl) nameEl.textContent = displayName.split(/\s+/)[0] || displayName;
    setText("#header-name", displayName);
    setText("#header-avatar", initials(displayName));

    await personalise(profile);
  });
</script>
